# =============================================================================
# One Minhaj — example environment
# =============================================================================
#
# Copy to `.env.local` and fill in values for local development. `.env*` is
# git-ignored; only this VALUELESS example is tracked
# (SECURITY_BASELINE.md 18.1: ".env git-ignored with a valueless .env.example").
#
# Values are deliberately empty. A populated example drifts into being treated
# as configuration, and the day a real credential is pasted beside the others
# it is committed without anyone noticing.
#
# NO REAL SECRETS BELONG IN THIS FILE, EVER.
#
# Phase 0B scope only. Database, authentication, OAuth, email, storage and
# payment configuration are added by the phases that introduce them — inventing
# them now would mean configuration for systems that do not exist and
# credentials nobody has issued.
#
# Every variable is validated at startup with Zod and the process fails fast:
#   server  -> packages/contracts/src/env/server.ts
#   client  -> packages/contracts/src/env/client.ts
#
# Each variable below is OPTIONAL in Phase 0B and falls back to the documented
# default when unset, so an empty file is a working local configuration.
#
# -----------------------------------------------------------------------------
# Server — private. May hold secrets in later phases. Never sent to the browser.
# -----------------------------------------------------------------------------

# development | test | production          (default: development)
NODE_ENV=

# Port the web process listens on.         (default: 3000)
PORT=

# Pino level:
# fatal | error | warn | info | debug | trace   (default: info)
LOG_LEVEL=

# Locale used when a visitor expresses no preference.
# en | ur | ar                             (default: en)
DEFAULT_LOCALE=

# -----------------------------------------------------------------------------
# Client — PUBLIC. Inlined into the browser bundle and disclosed to every
# visitor. A secret must never be placed here.
# -----------------------------------------------------------------------------

# The site's canonical origin.             (default: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# Default locale, mirrored for client-side resolution.
# en | ur | ar                             (default: en)
NEXT_PUBLIC_DEFAULT_LOCALE=
