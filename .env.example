# =============================================================================
# One Minhaj — example environment
# =============================================================================
#
# Copy the entries needed by a command into its ignored local environment file
# and fill in values. Phase 1 database and Compose commands use `docker/.env`.
# `.env*` is git-ignored; only this VALUELESS example is tracked
# (SECURITY_BASELINE.md 18.1: ".env git-ignored with a valueless .env.example").
#
# Values are deliberately empty. A populated example drifts into being treated
# as configuration, and the day a real credential is pasted beside the others
# it is committed without anyone noticing.
#
# NO REAL SECRETS BELONG IN THIS FILE, EVER.
#
# Phase 1 adds database configuration. Authentication, OAuth, email, storage and
# payment configuration are added by the phases that introduce them — inventing
# them now would mean configuration for systems that do not exist and
# credentials nobody has issued.
#
# Application variables are validated at startup with Zod and fail fast:
#   web server -> packages/contracts/src/env/server.ts
#   web client -> packages/contracts/src/env/client.ts
#   database   -> packages/database/src/config.ts
#
# Phase 0B variables remain optional. Database commands require the server-only
# database variables to be supplied by ignored local configuration; the
# migration, provisioning and seed commands additionally require the
# application-principal credentials.
#
# -----------------------------------------------------------------------------
# Server — private. May hold secrets in later phases. Never sent to the browser.
# -----------------------------------------------------------------------------

# development | test | production          (default: development)
NODE_ENV=

# Port the web process listens on.         (default: 3000)
PORT=

# Pino level:
# fatal | error | warn | info | debug | trace   (default: info)
LOG_LEVEL=

# Locale used when a visitor expresses no preference.
# en | ur | ar                             (default: en)
DEFAULT_LOCALE=

# SQL Server container administrator password. Local-only Compose secret.
MSSQL_SA_PASSWORD=

# Host-side port for the Minhaj SQL container. (default: 14330)
MINHAJ_SQLSERVER_PORT=

# Prisma/MSSQL application runtime connection. Server-only and secret-bearing.
DATABASE_URL=

# Privileged Prisma CLI, migration, provisioning and seed connection. Held by a
# separate principal from DATABASE_URL: the runtime account must not be able to
# change schema (SECURITY_BASELINE.md 18.2).
DATABASE_MIGRATION_URL=

# Least-privilege application login provisioned by `npm run db:provision`.
# It is granted INSERT and SELECT on the audit table and nothing else; UPDATE,
# DELETE and every form of DDL are explicitly denied (SECURITY_BASELINE.md 13.1).
DATABASE_APP_LOGIN=

# Password for the application login. Local-only, and never the sa password.
DATABASE_APP_PASSWORD=

# -----------------------------------------------------------------------------
# Client — PUBLIC. Inlined into the browser bundle and disclosed to every
# visitor. A secret must never be placed here.
# -----------------------------------------------------------------------------

# The site's canonical origin.             (default: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# Default locale, mirrored for client-side resolution.
# en | ur | ar                             (default: en)
NEXT_PUBLIC_DEFAULT_LOCALE=
