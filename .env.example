# =============================================================================
# One Minhaj — example environment
# =============================================================================
#
# Copy the entries needed by a command into its ignored local environment file
# and fill in values. Phase 1 database and Compose commands use `docker/.env`.
# `.env*` is git-ignored; only this VALUELESS example is tracked
# (SECURITY_BASELINE.md 18.1: ".env git-ignored with a valueless .env.example").
#
# Values are deliberately empty. A populated example drifts into being treated
# as configuration, and the day a real credential is pasted beside the others
# it is committed without anyone noticing.
#
# NO REAL SECRETS BELONG IN THIS FILE, EVER.
#
# Phase 1 adds database configuration and Phase 2 adds authentication and
# transactional email; later capabilities (storage in Phase 7, the Donations
# payment provider in Phase 27) add theirs with the phase that introduces them.
# Nothing is declared ahead of its consumer — that would mean configuration for
# systems that do not exist and credentials nobody has issued.
#
# Application variables are validated at startup with Zod and fail fast:
#   web server -> packages/contracts/src/env/server.ts
#   database   -> packages/database/src/config.ts
# No browser-visible environment variable currently has a consumer.
#
# Phase 0B variables remain optional. Database commands require the server-only
# database variables to be supplied by ignored local configuration; the
# migration, provisioning and seed commands additionally require the
# application-principal credentials.
#
# -----------------------------------------------------------------------------
# Server — private. May hold secrets in later phases. Never sent to the browser.
# -----------------------------------------------------------------------------

# development | test | production          (default: development)
NODE_ENV=

# Port the web process listens on.         (default: 3000)
PORT=

# Pino level:
# fatal | error | warn | info | debug | trace   (default: info)
LOG_LEVEL=

# SQL Server container administrator password. Local-only Compose secret.
MSSQL_SA_PASSWORD=

# Host-side port for the Minhaj SQL container. (default: 14330)
MINHAJ_SQLSERVER_PORT=

# Prisma/MSSQL application runtime connection. Server-only and secret-bearing.
DATABASE_URL=

# Privileged Prisma CLI, migration, provisioning and seed connection. Held by a
# separate principal from DATABASE_URL: the runtime account must not be able to
# change schema (SECURITY_BASELINE.md 18.2).
DATABASE_MIGRATION_URL=

# Least-privilege application login provisioned by `npm run db:provision`.
# Rights are granted per delivered table and per required verb; broad schema,
# migration and DDL authority remain denied (SECURITY_BASELINE.md 18.2).
DATABASE_APP_LOGIN=

# Password for the application login. Local-only, and never the sa password.
DATABASE_APP_PASSWORD=

# The dedicated PRIVILEGED-OPERATIONS login, provisioned by
# `npm run db:provision:operator`. A THIRD account: the migration principal can
# change schema and must not perform routine bootstrap or recovery, and the
# runtime principal must never be able to provision an administrator
# (SECURITY_BASELINE.md 8.3, 18.2).
#
# It holds EXECUTE on exactly two audited procedures and nothing else — no DDL,
# no table access, no ownership. Only the host-only commands read these:
# `npm run identity:bootstrap` and `npm run identity:recover`.
DATABASE_OPERATOR_LOGIN=
DATABASE_OPERATOR_PASSWORD=

# -----------------------------------------------------------------------------
# Phase 2 — Identity & Access. Server-only.
# -----------------------------------------------------------------------------

# Canonical application origin. Emailed links are built from it, and it bounds
# what the authentication library will redirect to.  (default: http://localhost:3000)
AUTH_BASE_URL=

# Versioned signing and encryption secrets, NEWEST FIRST:
#   <version>:<value>,<version>:<value>
# The head encrypts; the rest decrypt material written before a rotation. This
# is Better Auth's own rotation mechanism — no application keyring is built on
# top of it. The development default is a synthetic sentinel and is REJECTED in
# production (SECURITY_BASELINE.md 18.1).
AUTH_SECRETS=

# HMAC key for rate-limit subjects, and its version. Subjects are addresses and
# client IPs; keying them keeps personal data out of a table that exists only to
# count requests (SECURITY_BASELINE.md 19.2). Rotating the key starts fresh
# windows, which is why the version travels with it.
RATE_LIMIT_DIGEST_KEY=
RATE_LIMIT_DIGEST_KEY_VERSION=

# true | false — whether a reverse proxy in front of this process sets the
# X-Forwarded-For / X-Real-IP headers.        (default: false)
#
# The per-CLIENT rate-limit budget is keyed on that header, and the header is
# client-supplied unless something trustworthy overwrites it. Left false, every
# request shares one subject — a tighter bucket, never a looser one. Set it to
# true only where the deployment genuinely terminates at NGINX. The per-ACCOUNT
# budget never depends on this.
TRUST_PROXY_HEADERS=

# -----------------------------------------------------------------------------
# Phase 2 — transactional email. Server-only.
# -----------------------------------------------------------------------------

# Sender identity. Non-secret.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# HMAC key for recipient digests in delivery and suppression state, and its
# version. The delivery tables never hold an address in clear.
EMAIL_DIGEST_KEY=
EMAIL_DIGEST_KEY_VERSION=

# Phase 21 — HMAC key newsletter confirm and unsubscribe links are derived
# under, and its version. Only a hash of each link is stored.
NEWSLETTER_TOKEN_KEY=
NEWSLETTER_TOKEN_KEY_VERSION=

# The restricted Resend sending credential. CAPABILITY-CONDITIONAL: real sending
# is enabled only where this exists, and a build, a test run or CI must not
# require a live credential. Its absence never turns a real send into a pretend
# one — the provider reports itself unavailable and refuses.
RESEND_API_KEY=

# Resend webhook signing secret. CAPABILITY-CONDITIONAL in the same way — but a
# webhook request arriving while it is absent is REFUSED, never accepted
# unverified (SECURITY_BASELINE.md 7.2).
RESEND_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Phase 4 — public shell. Server-only.
# -----------------------------------------------------------------------------

# true | false — whether this deployment may be indexed at all.  (default: false)
#
# FAIL CLOSED. While the platform runs on a developer-controlled pre-adoption
# origin, the entire site is noindex, the crawler is disallowed and no sitemap is
# advertised, so that it neither competes with nor impersonates the official
# organisation site (ROUTE_MAP.md 9.5). Leave it unset or false everywhere until
# the approved official-origin launch transition.
#
# It is an environment and launch-state control, not a product mode: no route, no
# capability and no rendering changes with it.
PUBLIC_INDEXING_ENABLED=

# Phase 6 correspondence intake. Server-only activation gate.
# Leave unset until the privacy/support owner approves the retention period.
# Whole days (1..3650); the range is an engineering bound, not a policy choice.
CORRESPONDENCE_RETENTION_DAYS=

# Phase 7 storage foundation. Server-only; none of this is a browser's business.
# STORAGE_ROOT is an ABSOLUTE path outside the web root, `public/`, the
# repository source and `.next`. The application creates it on first use.
STORAGE_ROOT=
# Absolute ceiling for a single stored object, in bytes. A caller's own upload
# policy narrows this and can never raise it. Defaults to 64 MiB when unset.
STORAGE_MAX_BYTES=
# The ClamAV daemon. Scanning is fail-closed: when the scanner cannot be
# reached, uploads stay quarantined and are never served.
CLAMAV_HOST=
CLAMAV_PORT=
CLAMAV_TIMEOUT_MS=

# -----------------------------------------------------------------------------
# Phase 27 — Donations payment provider. Server-only.
# -----------------------------------------------------------------------------
#
# CAPABILITY-CONDITIONAL. Leave every entry unset and online giving is honestly
# UNAVAILABLE; nothing pretends to take a payment. Stripe is the SANDBOX
# ENGINEERING ADAPTER, not a production provider selection.
#
# The set is validated TOGETHER against the declared environment, with no
# fallback between environments:
#   fixture    -> the local simulator: sk_fixture_ / whsec_fixture_ synthetic
#                 values and a loopback DONATIONS_FIXTURE_PROVIDER_ORIGIN
#   sandbox    -> the provider's test mode: sk_test_ (or rk_test_, or the
#                 CLI sandbox's rkcs_test_) and whsec_
#   production -> real money: refused until an approved activation exists
# A key of the wrong environment leaves Donations unavailable. Real payment
# additionally needs the database activation record.

# stripe
DONATIONS_PROVIDER=

# fixture | sandbox | production
DONATIONS_PROVIDER_ENVIRONMENT=

# Non-secret merchant account label every provider reference is scoped by
# (letters, digits, `_` and `-`; for example the acct_ identifier).
DONATIONS_PROVIDER_ACCOUNT=

# Provider API secret. SECRET — never commit, never log.
DONATIONS_STRIPE_SECRET_KEY=

# Webhook endpoint signing secret. SECRET. Without it every webhook is refused,
# never accepted unverified (SECURITY_BASELINE.md 7.2).
DONATIONS_STRIPE_WEBHOOK_SECRET=

# fixture environment only: the simulator's http://127.0.0.1:<port> origin.
DONATIONS_FIXTURE_PROVIDER_ORIGIN=
