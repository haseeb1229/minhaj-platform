{
  "name": "@minhaj/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared types and Zod schemas. Layer 0 — importable by every context and by both processes, server and client.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./identity": "./src/identity/index.ts",
    "./taxonomy": "./src/taxonomy/index.ts",
    "./people": "./src/people/index.ts",
    "./platform": "./src/platform/index.ts",
    "./env/prerender": {
      "react-server": "./src/env/prerender.ts",
      "node": "./src/env/prerender.ts",
      "browser": "./src/env/server-in-client-error.ts",
      "default": "./src/env/prerender.ts"
    },
    "./env/prerender-build": {
      "types": "./src/env/prerender-build.ts",
      "node": "./src/env/prerender-build.ts",
      "browser": "./src/env/server-in-client-error.ts",
      "default": "./src/env/server-in-client-error.ts"
    },
    "./env/server": {
      "react-server": "./src/env/server.ts",
      "node": "./src/env/server.ts",
      "browser": "./src/env/server-in-client-error.ts",
      "default": "./src/env/server.ts"
    },
    "./editorial": "./src/editorial/index.ts",
    "./editorial/editor": "./src/editorial/editor.ts",
    "./library": "./src/library/index.ts",
    "./media": "./src/media/index.ts",
    "./global": "./src/global/index.ts",
    "./search": "./src/search/index.ts",
    "./quran": "./src/quran/index.ts",
    "./hadith": "./src/hadith/index.ts",
    "./fatwa": "./src/fatwa/index.ts",
    "./personalisation": "./src/personalisation/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "server-only": "0.0.1",
    "zod": "4.5.4",
    "@tiptap/starter-kit": "3.31.3"
  }
}
