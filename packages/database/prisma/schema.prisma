generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

/// Phase 1 audit foundation (SECURITY_BASELINE.md §13).
///
/// Append-oriented: the application inserts and never updates or deletes.
/// That discipline is enforced by database permissions, not by this model —
/// see `sql/permissions/grant-application-principal.sql`.
///
/// Actor and target are recorded as an identifier plus a type STRING rather
/// than a foreign key. Identity & Access, Editorial, Quran and Hadith are all
/// deferred to later phases, so a real relation cannot exist yet; inventing
/// those tables now to satisfy a constraint would create precisely the
/// premature business schema Phase 1 forbids (DELIVERY_PLAN.md §Phase 1).
model AuditLog {
  /// Stable audit identifier.
  id String @id @default(uuid()) @db.UniqueIdentifier

  /// Actor reference. Null for unauthenticated or system-originated events.
  actorId   String? @db.NVarChar(64)
  actorType String  @db.NVarChar(64)

  /// What happened, e.g. `fatwa.publish` (SECURITY_BASELINE.md §13.2).
  action String @db.NVarChar(128)

  /// Target entity type and identifier, resolved by the owning phase.
  targetType String  @db.NVarChar(128)
  targetId   String? @db.NVarChar(128)

  /// Before and after state, where the audited action has them.
  beforeState String? @db.NVarChar(Max)
  afterState  String? @db.NVarChar(Max)

  /// The authorising source for the action, where one is relevant.
  authorisingSource String? @db.NVarChar(128)

  /// Network origin. Sized for IPv6 including a zone index.
  ipAddress String? @db.NVarChar(64)

  /// Server-assigned in UTC. A client-supplied timestamp is a client-controlled
  /// fact, and `now()` would emit CURRENT_TIMESTAMP — local server time, which
  /// silently shifts meaning with the host timezone.
  occurredAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  @@index([occurredAt])
  @@index([actorId])
  @@index([targetType, targetId])
  /// Chunk 2. The read-only admin audit view filters by action and orders by
  /// time, and §28 permits INDEXED filters only — an unindexed `action`
  /// predicate over a table that grows forever is a scan the operator surface
  /// would perform on every page.
  @@index([action, occurredAt])
  @@map("AuditLog")
}

// ===========================================================================
// Phase 2 Chunk 1 — Identity & Access, and the Layer-0 concerns it first needs
// ===========================================================================
//
// OWNERSHIP. Physical placement here transfers no semantic ownership
// (ARCHITECTURE.md §4.1, §6.3 rule 14). `User`, `Session`, `Account` and
// `Verification` are owned by the IDENTITY & ACCESS context; `EmailDelivery`,
// `EmailSuppression` and `ProviderEvent` by the Layer-0 EMAIL concern;
// `RateLimitCounter` by the Layer-0 RATE-LIMITING concern. Those owners are
// declared in this package's own manifest under `minhaj.persistenceAdapters`,
// and the architecture gate fails closed on an adapter no declaration owns.
//
// LIFECYCLE. `User`, `Session`, `Account` and `Verification` carry Better
// Auth's mechanics and One Minhaj's application state on the SAME physical
// row — there is no second user table and no join to keep in step. Better
// Auth 1.7.4 owns their write mechanics; One Minhaj owns the columns marked
// below and every rule about them. The shape is proved against the library's
// own `getSchema()` by test rather than trusted (P-2).
//
// SIZING. Every uniquely indexed string column is sized explicitly. Prisma's
// default `String` on SQL Server is NVARCHAR(1000) = 2000 bytes, above the
// 1700-byte nonclustered index key limit, so a default would push a unique
// index over the edge.
//
// TIMESTAMPS. `createdAt`/`updatedAt` on the Better Auth tables carry NO
// database default, deliberately: Better Auth always supplies them, and
// Prisma's `now()` emits CURRENT_TIMESTAMP — local server time, which shifts
// meaning with the host timezone. Tables this project writes itself use
// `SYSUTCDATETIME()`, exactly as `AuditLog` does.

/// Application identity. Authoritative for roles, preferences and application
/// state (SECURITY_BASELINE.md §2.2); Better Auth authenticates it.
model User {
  pageCreations Page[] @relation("PageCreator")
  pageApprovals Page[] @relation("PageReviewer")
  pageSchedules Page[] @relation("PageScheduler")
  pageRevisions PageRevision[]

  articleCreations Article[] @relation("ArticleCreator")
  articleApprovals Article[] @relation("ArticleReviewer")
  articleSchedules Article[] @relation("ArticleScheduler")
  articleRevisions ArticleRevision[]

  newsArticleCreations NewsArticle[] @relation("NewsArticleCreator")
  newsArticleApprovals NewsArticle[] @relation("NewsArticleReviewer")
  newsArticleSchedules NewsArticle[] @relation("NewsArticleScheduler")
  newsArticleRevisions NewsArticleRevision[]

  eventCreations Event[] @relation("EventCreator")
  eventApprovals Event[] @relation("EventReviewer")
  eventSchedules Event[] @relation("EventScheduler")
  eventRevisions EventRevision[]
  collectionCreations Collection[] @relation("CollectionCreator")
  collectionApprovals Collection[] @relation("CollectionReviewer")
  collectionSchedules Collection[] @relation("CollectionScheduler")
  collectionRevisions CollectionRevision[]

  pressReleaseCreations PressRelease[] @relation("PressReleaseCreator")
  pressReleaseApprovals PressRelease[] @relation("PressReleaseReviewer")
  pressReleaseSchedules PressRelease[] @relation("PressReleaseScheduler")
  pressReleaseRevisions PressReleaseRevision[]

  statementCreations Statement[] @relation("StatementCreator")
  statementApprovals Statement[] @relation("StatementReviewer")
  statementSchedules Statement[] @relation("StatementScheduler")
  statementRevisions StatementRevision[]

  mediaCoverageCreations MediaCoverage[] @relation("MediaCoverageCreator")
  mediaCoverageApprovals MediaCoverage[] @relation("MediaCoverageReviewer")
  mediaCoverageSchedules MediaCoverage[] @relation("MediaCoverageScheduler")
  mediaCoverageRevisions MediaCoverageRevision[]

  fatwaQuestionsAsked     FatwaQuestion[]       @relation("FatwaQuestionAsker")
  fatwaQuestionsAssigned  FatwaQuestion[]       @relation("FatwaQuestionAssignee")
  fatwaQuestionsTriaged   FatwaQuestion[]       @relation("FatwaQuestionTriager")
  fatwaQuestionsRouted    FatwaQuestion[]       @relation("FatwaQuestionAssigner")
  fatwaQuestionsDeclined  FatwaQuestion[]       @relation("FatwaQuestionDecliner")
  fatwaRevisionsAuthored  FatwaRevision[]
  fatwaPublications       FatwaPublication[]
  fatwaReviewDecisions    FatwaReviewDecision[]

  /// Phase 21 BACK-REFERENCES PRISMA REQUIRES, AND NOT DEPENDENCIES. Each
  /// relation is declared and owned on the Personalisation side; Identity
  /// never reads them, and account closure reaches them only through
  /// Personalisation's own disposition (SECURITY_BASELINE.md §19.1). There is
  /// deliberately none to `NewsletterSubscriber`, which is not an account's.
  personalisationProfile  PersonalisationProfile?
  savedItems              SavedItem[]
  privateCollections      PrivateCollection[]
  readingHistory          ReadingHistory[]
  watchHistory            WatchHistory[]
  quranReadingProgress    QuranReadingProgress?
  notificationPreferences NotificationPreference[]
  notifications           Notification[]

  /// Phase 22 BACK-REFERENCES PRISMA REQUIRES, AND NOT DEPENDENCIES. Each is
  /// owned on the Learning side; Identity never reads them, and account closure
  /// reaches them only through Learning's own disposition.
  enrolments        Enrolment[]
  trialRequests     TrialClassRequest[]

  /// Phase 23 BACK-REFERENCES PRISMA REQUIRES, AND NOT DEPENDENCIES. Each is
  /// owned on the Learning side — a typed teaching scope, a teacher's window,
  /// a learner's Booking and Attendance, and a class service-mail intent.
  /// Identity never reads them; closure reaches them only through Learning's
  /// own disposition, and revocation needs none of them.
  teachingScopes            CourseTeachingAssignment[]
  availability              Availability[]
  bookings                  Booking[]
  attendance                Attendance[]
  classCommunicationIntents ClassCommunicationIntent[]

  id String @id @db.NVarChar(36)

  // ---- Better Auth core -------------------------------------------------
  name          String  @db.NVarChar(200)
  email         String  @unique @db.NVarChar(320)
  emailVerified Boolean
  image         String? @db.NVarChar(2048)

  createdAt DateTime @db.DateTime2
  updatedAt DateTime @db.DateTime2

  // ---- One Minhaj-owned application state -------------------------------
  //
  // Declared to Better Auth as `user.additionalFields` with `input: false`,
  // so none of them can be set by a sign-up body. They change only through
  // Identity's own services (DOMAIN_MODEL.md §4.2).

  /// Account INTERFACE locale — distinct from content language (§19.1).
  locale String @db.NVarChar(8)

  /// IANA zone for user-facing scheduling (§19.5). Absent until chosen.
  timezone String? @db.NVarChar(64)

  /// active | disabled | suspended | closed. Enforced on EVERY authenticated
  /// request, not only at sign-in (DOMAIN_MODEL.md §4.6).
  status String @db.NVarChar(32)

  /// Set when account setup completes. NOT personalisation onboarding, which
  /// belongs to Phase 21 (DOMAIN_MODEL.md §4.2, §14.1).
  accountSetupCompletedAt DateTime? @db.DateTime2

  /// Closure. The row is RETAINED for historical attribution; the address is
  /// replaced by a non-routable tombstone and profile data pseudonymised, so
  /// later re-registration with the original address starts clean.
  closedAt        DateTime? @db.DateTime2
  pseudonymisedAt DateTime? @db.DateTime2

  /// Better Auth's own two-factor flag (Chunk 2). VENDOR-OWNED: the library
  /// sets it when an enrolment is verified and clears it on disable, and this
  /// platform never writes it. It is NOT the privileged posture — an enrolled
  /// factor whose recovery codes were never confirmed does not satisfy
  /// SECURITY_BASELINE.md §8.2. `PrivilegedSecurityPosture` holds that.
  ///
  /// Non-null WITH a default, which is what lets Better Auth omit it on an
  /// insert; `input: false` keeps it off every sign-up body.
  twoFactorEnabled Boolean @default(false)

  sessions             Session[]
  accounts             Account[]
  communicationIntents IdentityCommunicationIntent[]
  securityOperations   IdentitySecurityOperation[]
  roleAssignments      RoleAssignment[]
  stepUpGrants         StepUpGrant[]
  twoFactor            TwoFactor[]
  privilegedPosture    PrivilegedSecurityPosture?

  /// The OPTIONAL public contributor record this account belongs to (Phase 5).
  ///
  /// A BACK-REFERENCE PRISMA REQUIRES, AND NOT A DEPENDENCY. The relation is
  /// declared and owned on `Person`, which holds the foreign key and the unique
  /// index; this side exists only because Prisma will not accept a one-sided
  /// relation. Identity never reads it — the Identity services, adapters and
  /// authorisation path contain no reference to `Person` — because People owns
  /// the link and its disposition (DOMAIN_MODEL.md §5.1, SECURITY_BASELINE.md
  /// §19.1). A `User` with no `Person` is the ordinary case.
  person Person?

  @@index([status])
  @@index([createdAt])
  @@map("User")
}

/// Server-side session record. Its existence is what makes revocation
/// possible (SECURITY_BASELINE.md §2.3).
model Session {
  id        String   @id @db.NVarChar(36)
  expiresAt DateTime @db.DateTime2
  token     String   @unique @db.NVarChar(255)
  createdAt DateTime @db.DateTime2
  updatedAt DateTime @db.DateTime2
  ipAddress String?  @db.NVarChar(64)
  userAgent String?  @db.NVarChar(512)

  userId String @db.NVarChar(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Step-up grants die with the session that earned them (Chunk 2).
  stepUpGrants StepUpGrant[]

  @@index([userId])
  @@index([expiresAt])
  @@map("Session")
}

/// One authentication method bound to a User. Phase 2 creates only the
/// `credential` provider; Phase 2G adds Google through this same shape, which
/// is why the linking seam needs no later schema change.
model Account {
  id         String @id @db.NVarChar(36)
  accountId  String @db.NVarChar(255)
  providerId String @db.NVarChar(64)

  userId String @db.NVarChar(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Provider tokens. Unused by the credential provider; present because the
  /// library's shape requires them and Phase 2G will populate them.
  accessToken           String?   @db.NVarChar(Max)
  refreshToken          String?   @db.NVarChar(Max)
  idToken               String?   @db.NVarChar(Max)
  accessTokenExpiresAt  DateTime? @db.DateTime2
  refreshTokenExpiresAt DateTime? @db.DateTime2
  scope                 String?   @db.NVarChar(1000)

  /// scrypt hash, `salt:key` hex — 161 characters at Better Auth's
  /// N=16384, r=16, p=1, dkLen=64 parameters. NEVER logged, NEVER audited.
  password String? @db.NVarChar(255)

  createdAt DateTime @db.DateTime2
  updatedAt DateTime @db.DateTime2

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("Account")
}

/// Better Auth's authoritative token store — and the ONLY durable home for
/// auth bearer material in this platform (ARCHITECTURE.md §4.6.1).
///
/// It holds email-verification, password-reset and email-change tokens under
/// the Email-OTP lifecycle, stored encrypted and recoverable so a failed
/// DELIVERY can be retried with the SAME token rather than minting a second
/// one. No other table may ever carry a bearer token.
model Verification {
  id         String   @id @db.NVarChar(36)
  identifier String   @db.NVarChar(400)
  value      String   @db.NVarChar(2000)
  expiresAt  DateTime @db.DateTime2
  createdAt  DateTime @db.DateTime2
  updatedAt  DateTime @db.DateTime2

  @@index([identifier])
  @@index([expiresAt])
  @@map("Verification")
}

/// IDENTITY-OWNED durable intent for required, TOKEN-FREE communication —
/// "your password was changed", "your email was changed", security alerts.
///
/// For Identity-owned changes it commits in the owning transaction. For the
/// three private Better Auth mutations it is finalized from a durable operation
/// stamp that commits with the vendor write. Layer 4 relays only after Identity
/// commit; no cross-owner transaction capability exists (ARCHITECTURE.md §3.1.2.1).
///
/// It carries NO bearer token, ever. Token-bearing mail is driven from
/// `Verification` instead, which is why this table has no token column to
/// misuse.
model IdentityCommunicationIntent {
  id String @id @default(dbgenerated("CONVERT(nvarchar(36), NEWID())")) @db.NVarChar(36)

  /// Why the message exists, e.g. `identity.password-changed`.
  purpose String @db.NVarChar(64)

  userId String @db.NVarChar(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Interface locale to render in, captured at commit so a later locale
  /// change cannot retranslate an already-described event.
  locale String @db.NVarChar(8)

  /// Deterministic per (purpose, user, event) so a relay retry cannot produce
  /// a second message.
  idempotencyKey String @unique @db.NVarChar(200)

  /// Where to send it, when the account's own address can no longer say.
  ///
  /// NULL for every intent but one. Account closure replaces the address with
  /// a non-routable tombstone in the SAME transaction that commits this row,
  /// so by the time the relay runs there is nothing left to read the former
  /// address from — and the closure notice is precisely the message that has
  /// to reach it. Reading the tombstone back is not an option and neither is
  /// leaving the old address on the closed `User`: the point of closure is
  /// that the row stops naming the person (DOMAIN_MODEL.md §4.6).
  ///
  /// BOUNDED BY CONSTRUCTION. It is written only by closure and CLEARED the
  /// moment the intent is relayed, so it lives for the seconds between the
  /// closure transaction and the next dispatch tick — not for the lifetime of
  /// the row. That is the whole of its retention, and it is enforced in the
  /// same operation that marks the intent relayed rather than by a policy
  /// somebody has to remember (SECURITY_BASELINE.md §19.2).
  recipientOverride String? @db.NVarChar(320)

  /// pending | relayed | abandoned
  status String @db.NVarChar(16)

  relayedAt DateTime? @db.DateTime2
  createdAt DateTime  @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  @@index([status, createdAt])
  @@map("IdentityCommunicationIntent")
}

/// Identity-only crash marker for vendor-owned password/email mutations.
/// It contains no password, hash, bearer token or address. `committedAt` is
/// stamped in the same SQL transaction as the authoritative vendor write.
model IdentitySecurityOperation {
  id String @id @default(dbgenerated("CONVERT(nvarchar(36), NEWID())")) @db.NVarChar(36)
  /// password-reset | password-change | email-change
  kind String @db.NVarChar(32)
  userId String @db.NVarChar(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  initiatingSessionId String? @db.NVarChar(36)
  replacementSessionId String? @db.NVarChar(36)
  committedAt DateTime? @db.DateTime2
  cancelledAt DateTime? @db.DateTime2
  completedAt DateTime? @db.DateTime2
  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  @@index([completedAt, committedAt, createdAt])
  @@index([userId, completedAt])
  @@map("IdentitySecurityOperation")
}

/// LAYER-0 EMAIL. Provider delivery metadata and nothing else.
///
/// It records THAT a message of a given purpose is owed to a recipient and how
/// delivery went. It never stores the message body, the recipient's address in
/// clear, or — above all — an auth bearer token. The recipient is a keyed
/// digest; `sourceReference` is an opaque handle the originating owner can
/// resolve back to its own authoritative state.
model EmailDelivery {
  id String @id @default(dbgenerated("CONVERT(nvarchar(36), NEWID())")) @db.NVarChar(36)

  purpose String @db.NVarChar(64)

  /// HMAC digest of the canonical recipient address, key-versioned. Raw
  /// addresses do not belong in general infrastructure storage (§19.2).
  recipientDigest  String @db.NVarChar(64)
  digestKeyVersion Int

  /// Opaque handle to the owner's authoritative state — for token mail, the
  /// delivery identity the auth-mechanics port can re-materialise from. It is
  /// NOT the token and cannot be exchanged for one by anything but that port.
  sourceReference String @db.NVarChar(200)

  /// Stable across retries of the SAME message, and sent to the provider as
  /// `Idempotency-Key`.
  idempotencyKey String @unique @db.NVarChar(200)

  /// pending | sending | sent | failed | suppressed
  status String @db.NVarChar(16)

  attemptCount  Int
  nextAttemptAt DateTime? @db.DateTime2

  /// Lease, so a crashed dispatcher's row becomes claimable again and two
  /// dispatchers can never send the same message concurrently. This is the
  /// leasing multi-instance execution requires (ARCHITECTURE.md §3.5.1).
  claimedUntil DateTime? @db.DateTime2

  /// Normalised failure CLASS and CODE only — never a provider payload.
  failureClass String? @db.NVarChar(16)
  failureCode  String? @db.NVarChar(64)

  providerMessageId String? @db.NVarChar(200)

  createdAt DateTime  @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  sentAt    DateTime? @db.DateTime2

  @@index([status, nextAttemptAt])
  @@index([recipientDigest])
  @@map("EmailDelivery")
}

/// LAYER-0 EMAIL. Addresses that must not be sent to, from bounce and
/// complaint events.
///
/// Typed by reason and scope so the distinction is structural from the first
/// row: marketing suppression can never suppress security or account-service
/// mail (ARCHITECTURE.md §4.6.1).
model EmailSuppression {
  id String @id @default(dbgenerated("CONVERT(nvarchar(36), NEWID())")) @db.NVarChar(36)

  recipientDigest  String @unique @db.NVarChar(64)
  digestKeyVersion Int

  /// bounce | complaint
  reason String @db.NVarChar(16)

  /// transactional | marketing — the scope the suppression applies to.
  scope String @db.NVarChar(16)

  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  @@index([reason])
  @@map("EmailSuppression")
}

/// LAYER-0 EMAIL. Inbound provider event de-duplication (protocol class B).
///
/// The same event delivered twice produces exactly one effect, and a replayed
/// event identifier is refused. Only the identifiers and the type are kept —
/// no arbitrary provider payload is stored (SECURITY_BASELINE.md §7.2).
model ProviderEvent {
  id String @id @default(dbgenerated("CONVERT(nvarchar(36), NEWID())")) @db.NVarChar(36)

  provider String @db.NVarChar(32)
  eventId  String @db.NVarChar(200)
  type     String @db.NVarChar(64)

  receivedAt  DateTime  @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  processedAt DateTime? @db.DateTime2

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@map("ProviderEvent")
}

/// LAYER-0 RATE LIMITING. One shared store, two callers.
///
/// Better Auth reaches it through its `customStorage.consume(key, rule)`
/// contract and the application's own mutations reach it directly, so there
/// are not two contradictory limiters (ARCHITECTURE.md §4.5).
///
/// Subjects are keyed HMAC digests: a raw email address or IP in an
/// infrastructure table is personal data nobody asked to store (§19.2).
model RateLimitCounter {
  /// Purpose-scoped, key-versioned HMAC of the subject.
  key String @id @db.NVarChar(200)

  keyVersion Int

  count           Int
  windowStartedAt DateTime @db.DateTime2
  windowExpiresAt DateTime @db.DateTime2

  @@index([windowExpiresAt])
  @@map("RateLimitCounter")
}

// ===========================================================================
// Phase 2 Chunk 2 — authorisation, step-up and privileged second factor
// ===========================================================================
//
// OWNERSHIP. Every model below belongs to the IDENTITY & ACCESS context, which
// already owns its adapter directory in this package's manifest. Physical
// placement transfers no semantic ownership (ARCHITECTURE.md §4.1).
//
// ONE ENFORCEMENT PATH. `Permission` is the vocabulary, `Role` bundles it,
// `RoleAssignment` binds a bundle to an account, and `can()` reads exactly
// those three. There is no second boolean anywhere that decides authority
// (SECURITY_BASELINE.md §3.1, DOMAIN_MODEL.md §4.4).
//
// NO FUTURE-DOMAIN VOCABULARY. The seeded catalogue is Identity's and the
// system surfaces' only. Quran, Fatwa, Learning and the rest arrive with the
// contexts that own them.
//
// NO SPECULATIVE SCOPE. DOMAIN_MODEL.md §4.4 says a RoleAssignment may
// OPTIONALLY be scoped — "for example to one Centre or one Course". Neither
// Centre nor Course exists, so no scope column is created: a generic
// `scopeType + scopeId` added now would be exactly the polymorphic reference
// §6.2 prohibits, and a typed one would need a table from a context that has
// not shipped. Scoped privilege arrives with its owning domain, through a
// typed relation.

/// The immutable permission catalogue.
///
/// MIGRATION-SEEDED AND RUNTIME READ-ONLY. The runtime principal holds SELECT
/// and nothing else on this table, so "a permission cannot be created at
/// runtime" is enforced by the database rather than by an application check
/// somebody could forget (SECURITY_BASELINE.md §18.2).
///
/// The KEY is the primary key. A permission's identity IS its code: that is
/// what `can(user, 'permissions.grant')` names, and a surrogate id would allow
/// two rows to claim the same code.
model Permission {
  key         String @id @db.NVarChar(64)
  description String @db.NVarChar(200)

  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  roles RolePermission[]

  @@map("Permission")
}

/// A named bundle of permissions.
///
/// PROTECTED SYSTEM ROLES are `system = true`. They are foundation data the
/// migration controls: the Platform Administrator role must already exist for
/// the one-time bootstrap to assign it, and no runtime path renames,
/// re-bundles or deactivates it. Custom roles are everything else and carry
/// the full lifecycle.
model Role {
  id String @id @default(dbgenerated("CONVERT(nvarchar(36), NEWID())")) @db.NVarChar(36)

  /// Stable code, e.g. `platform-administrator`. Never a display string.
  key String @unique @db.NVarChar(64)

  name        String @db.NVarChar(120)
  description String @db.NVarChar(400)

  /// Protected foundation data when true.
  system Boolean

  /// Soft deactivation. A custom role with history is never destroyed; its
  /// authority stops and the record of who held it survives.
  deactivatedAt DateTime? @db.DateTime2

  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  permissions RolePermission[]
  assignments RoleAssignment[]

  @@index([system])
  @@map("Role")
}

/// Role membership of a permission. SET semantics, by construction.
///
/// The composite primary key is what makes a duplicate membership impossible
/// under concurrency — two racing writers cannot both insert the same pair,
/// and neither needs to read first to find out.
model RolePermission {
  roleId        String @db.NVarChar(36)
  permissionKey String @db.NVarChar(64)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  /// NO ACTION, deliberately: the catalogue is immutable, so a cascade here
  /// would describe a deletion that cannot happen.
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: NoAction, onUpdate: NoAction)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("RolePermission")
}

/// Binds an account to a role, with grant and revoke history.
///
/// NO DESTRUCTIVE RUNTIME DELETE. A revoked assignment is marked, not removed:
/// "this person held the administrator role between these dates" is precisely
/// the fact an investigation needs, and it is the fact a delete destroys.
///
/// AT MOST ONE LIVE ASSIGNMENT per (account, role), enforced by a FILTERED
/// unique index the migration creates — `WHERE [revokedAt] IS NULL`. Prisma's
/// schema language cannot express a filtered index, so it is written in the
/// migration and asserted by the lifecycle proof. Race-safety is a schema
/// property, not an application check (DOMAIN_MODEL.md §4.6).
model RoleAssignment {
  id String @id @default(dbgenerated("CONVERT(nvarchar(36), NEWID())")) @db.NVarChar(36)

  userId String @db.NVarChar(36)
  roleId String @db.NVarChar(36)

  /// NO ACTION on both: neither a User nor a Role is ever hard-deleted at
  /// runtime, and a cascade would offer a way to erase privilege history.
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  grantedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  /// Historical ATTRIBUTION identifiers, not relations — the same accepted
  /// pattern `AuditLog` uses (SECURITY_BASELINE.md §13.3). The grantor may
  /// later close their account; the record of who granted must survive that
  /// without a constraint deciding whether it may.
  grantedById   String? @db.NVarChar(36)
  grantedReason String? @db.NVarChar(200)

  revokedAt     DateTime? @db.DateTime2
  revokedById   String?   @db.NVarChar(36)
  revokedReason String?   @db.NVarChar(200)

  /// Phase 23 BACK-REFERENCE PRISMA REQUIRES, AND NOT A DEPENDENCY. Learning's
  /// typed Course teaching scope names the exact assignment that carried
  /// `teaching.perform`; Identity never reads it, and revocation changes this
  /// row alone — the scope stays as Learning's own safe history.
  teachingScopes CourseTeachingAssignment[]

  @@index([userId, revokedAt])
  @@index([roleId, revokedAt])
  @@map("RoleAssignment")
}

/// Durable, revocable proof that somebody re-authenticated a moment ago.
///
/// NOT A TOKEN and not a second session. It is a row: nothing a client sends
/// creates one, nothing carries it, and revoking it is a delete. It is bound
/// to ONE session and ONE purpose, so re-proving yourself to change your own
/// second factor does not silently authorise granting somebody the
/// administrator role (SECURITY_BASELINE.md §8.1).
///
/// The session FOREIGN KEY cascades. A revoked session takes its grants with
/// it, which makes "a step-up grant is unusable after its session is revoked"
/// a property of the schema rather than of remembering to delete twice.
model StepUpGrant {
  id String @id @default(dbgenerated("CONVERT(nvarchar(36), NEWID())")) @db.NVarChar(36)

  userId    String @db.NVarChar(36)
  sessionId String @db.NVarChar(36)

  /// privilege-administration | account-administration | second-factor
  purpose String @db.NVarChar(32)

  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  expiresAt DateTime @db.DateTime2

  /// NO ACTION on the user and CASCADE on the session: one cascade path only,
  /// which is what SQL Server permits, and the cascading one is the path that
  /// carries the security meaning.
  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([sessionId, purpose, expiresAt])
  @@index([expiresAt])
  @@map("StepUpGrant")
}

/// Better Auth's two-factor record. VENDOR-OWNED MECHANICS.
///
/// The library owns every column: the TOTP secret and the recovery codes are
/// stored encrypted under its own key configuration, and this platform never
/// decrypts, reads back or copies either. There is deliberately no operation
/// anywhere in this repository that returns the stored secret or lists
/// existing codes (SECURITY_BASELINE.md §8.2).
///
/// `failedVerificationCount` and `lockedUntil` are the library's SIGN-IN
/// lockout, and they apply on the sign-in path only. The signed-in
/// verification path has no library-side attempt budget at all, which is why
/// every application-controlled privileged proof endpoint spends the SQL rate
/// limiter instead (SECURITY_BASELINE.md §8.2).
model TwoFactor {
  id String @id @default(dbgenerated("CONVERT(nvarchar(36), NEWID())")) @db.NVarChar(36)

  /// Encrypted TOTP secret. NEVER logged, NEVER audited, never returned.
  secret String @db.NVarChar(Max)

  /// Encrypted single-use recovery codes. Same rules.
  backupCodes String @db.NVarChar(Max)

  userId String @db.NVarChar(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// False until the first correct code proves the authenticator works.
  verified Boolean @default(false)

  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.DateTime2

  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  @@index([userId])
  @@map("TwoFactor")
}

/// THE privileged second-factor posture — One Minhaj's, not the library's.
///
/// WHY IT IS NOT `User.twoFactorEnabled`. That flag says a factor is enrolled.
/// SECURITY_BASELINE.md §8.2 requires more than that before high-consequence
/// authority may be exercised: the recovery codes must have been issued AND
/// confirmed as stored, because an enrolled factor with no usable recovery is
/// a lockout waiting to be resolved by exactly the silent administrative
/// disable the baseline forbids.
///
/// `reenrolmentRequiredAt` is what the host-only operational recovery sets. It
/// keeps privileged capability denied until the account enrols again, WITHOUT
/// touching the role assignment — recovery never grants and never regrants a
/// role (SECURITY_BASELINE.md §8.3).
model PrivilegedSecurityPosture {
  userId String @id @db.NVarChar(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  secondFactorVerifiedAt   DateTime? @db.DateTime2
  recoveryCodesIssuedAt    DateTime? @db.DateTime2
  recoveryCodesConfirmedAt DateTime? @db.DateTime2
  reenrolmentRequiredAt    DateTime? @db.DateTime2

  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  @@map("PrivilegedSecurityPosture")
}

/// The one-time initial privileged operator bootstrap (SECURITY_BASELINE.md §8.3).
///
/// SELF-CLOSING BY THE PRIMARY KEY. There is exactly one legal id, so a second
/// successful bootstrap is a primary-key violation rather than a rule somebody
/// has to check — which is also what makes concurrent attempts resolve to
/// exactly one winner.
///
/// It records the DATABASE login that performed it, taken from
/// `ORIGINAL_LOGIN()` inside the procedure rather than from a parameter: an
/// operator identity a caller supplies is an operator identity a caller can
/// choose.
model IdentityBootstrap {
  /// Always `platform-administrator`. Enforced by a CHECK constraint.
  id String @id @db.NVarChar(64)

  targetUserId  String   @db.NVarChar(36)
  operatorLogin String   @db.NVarChar(128)
  ticket        String   @db.NVarChar(200)
  completedAt   DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  @@map("IdentityBootstrap")
}

// ===========================================================================
// Phase 3B — Taxonomy
// ===========================================================================
//
// OWNERSHIP. Every model below belongs to the TAXONOMY context, which owns its
// own adapter directory in this package's manifest. Physical placement here
// transfers no semantic ownership (ARCHITECTURE.md §4.1, §6.3 rule 14).
//
// WHAT IS NOT HERE, AND WHY IT MATTERS MOST.
//
// There is no `TopicAssignment`, no `targetType + targetId`, and no
// `ArticleTopic`, `QuranTopic`, `FatwaTopic` or any of the other junctions
// DOMAIN_MODEL.md §6.2 names. The first is prohibited outright — SQL Server
// cannot foreign-key a polymorphic pair to many tables, so such a design
// guarantees dangling references. The rest are absent because their TARGETS do
// not exist: Article, Quran, Hadith and Fatwa belong to contexts that have not
// shipped, and creating placeholder tables to hang a junction from would be
// precisely the premature business schema the delivery plan forbids.
//
// What Phase 3B delivers instead is the INTEGRATION RULE and the proof that it
// holds: a later owner creates its own typed junction — real foreign key to
// `Topic`, real foreign key to its own target — at its owning phase. The
// Taxonomy adapter reads the database's foreign-key catalogue to report which
// such relationships actually exist, and an integration test builds one against
// a synthetic target in a disposable database to prove the integrity the rule
// promises. Neither requires a table here.
//
// NO HARD DELETE ANYWHERE IN THIS SECTION. `Topic`, `Language` and `Tag` are
// archived or retired, never removed, and the runtime principal holds no DELETE
// on any of them. That is what makes "a topic assignment cannot be orphaned by
// an administrator" a property of the grant rather than of a check somebody
// wrote; it is the same posture `Role` already has.

/// The canonical, hierarchical, locale-aware subject taxonomy
/// (DOMAIN_MODEL.md §6.1).
///
/// HIERARCHY SAFETY IS IN THE DATABASE, not in the application. A CHECK
/// constraint refuses a self-parent, and the `TaxonomyTopicHierarchy` trigger —
/// holding a transaction-scoped application lock — refuses a cycle and a tree
/// deeper than the accepted bound. Two concurrent re-parents therefore cannot
/// both read the old shape and commit a loop between them, which no amount of
/// application validation alone cannot prevent.
///
/// `system` MARKS THE CANONICAL SEED. The nineteen top-level topics
/// DOMAIN_MODEL.md §6.1 names are foundation data the migration controls: their
/// slug is stable, they stay at the root, and they are not archived. Their
/// localised names and descriptions ARE administrable, because how a subject is
/// worded in Urdu is editorial work and not a schema decision. The flag mirrors
/// `Role.system`, and for the same reason.
model Topic {
  workTopics WorkTopic[]
  pageTopics PageTopic[]
  researchTopics ResearchTopic[]
  researchPaperTopics ResearchPaperTopic[]
  publicationTopics PublicationTopic[]
  magazineTopics MagazineTopic[]
  magazineIssueTopics MagazineIssueTopic[]
  encyclopediaTopics EncyclopediaTopic[]
  videoTopics VideoTopic[]
  audioTrackTopics AudioTrackTopic[]

  articleTopics ArticleTopic[]
  newsArticleTopics NewsArticleTopic[]
  eventTopics EventTopic[]
  collectionTopics CollectionTopic[]
  pressReleaseTopics PressReleaseTopic[]
  statementTopics StatementTopic[]
  mediaCoverageTopics MediaCoverageTopic[]
  quranTopics QuranTopic[]
  hadithTopics HadithTopic[]
  fatwaCategories FatwaCategory[]
  fatwaRevisionTopics FatwaRevisionTopic[]
  courseTopics CourseTopic[]

  id String @id @default(dbgenerated("CONVERT(nvarchar(36), NEWID())")) @db.NVarChar(36)

  /// Stable, globally unique, URL-safe identity. `/topics/{slug}` sits at the
  /// root of the route map (ROUTE_MAP.md §3.1), so uniqueness is global rather
  /// than per parent: two `history` topics under different parents would be two
  /// rows competing for one public URL.
  ///
  /// NOT DERIVED FROM A NAME. The name is localised; a slug derived from it
  /// would depend on which locale the creator happened to be working in.
  slug String @unique @db.NVarChar(160)

  /// Parent Topic, or null for a root.
  ///
  /// NO ACTION on both edges. SQL Server refuses a cascading self-reference
  /// outright, and NO ACTION is also what this model wants: deleting a topic
  /// would have to decide the fate of its subtree, and nothing deletes a topic.
  parentId String? @db.NVarChar(36)
  parent   Topic?  @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Topic[] @relation("TopicHierarchy")

  /// Sibling order. Ordering is `position` then `slug`, and because slug is
  /// globally unique that pair is TOTAL — two siblings sharing a position still
  /// render in the same order on every request.
  position Int

  /// active | archived. The smallest lifecycle a canonical taxonomy needs;
  /// editorial publication workflow belongs to the contexts that publish.
  status String @db.NVarChar(16)

  /// Protected canonical seed data when true.
  system Boolean

  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  translations TopicTranslation[]

  /// The one index the hierarchy read needs: seek the children of one parent,
  /// already in order. Nothing else here is queried by a predicate the
  /// clustered key does not already serve, and an index with no query behind it
  /// is write cost nobody asked for.
  @@index([parentId, position])
  @@map("Topic")
}

/// A Topic's name and description in ONE INTERFACE LOCALE.
///
/// TRANSLATION ROWS, NOT PARALLEL COLUMNS. DOMAIN_MODEL.md §19.1 is explicit:
/// locale-aware fields are rows related to the parent record, never
/// `name_en`/`name_ur`. Adding a fourth interface locale is then a data
/// operation, and a missing translation is detectable by a query.
///
/// KEYED BY INTERFACE LOCALE, AND DELIBERATELY NOT BY `Language`.
///
/// This is the distinction DOMAIN_MODEL.md §18 names as a modelling error to
/// avoid. A `Language` row is a CONTENT language — what a work is written in.
/// A Topic is not written in anything; it is a label the interface renders, so
/// it follows the locale the interface is being read in, exactly as
/// `User.locale` and `IdentityCommunicationIntent.locale` do. Keying this table
/// to `Language` would mean an administrator retiring a content language
/// silently changed which topic names the site can display.
///
/// ONE ROW PER (TOPIC, LOCALE), by the composite primary key. That is what
/// makes a duplicate impossible under concurrency rather than merely unlikely:
/// two editors saving the Urdu name at once produce one row, and neither had to
/// read first to find out.
///
/// THE FALLBACK TRANSLATION CANNOT BE REMOVED. `TaxonomyTopicFallback` refuses
/// any delete or update that would leave a Topic without its `en` row, so
/// resolving a Topic in any locale always yields a name (ROUTE_MAP.md §1.1).
model TopicTranslation {
  topicId String @db.NVarChar(36)

  /// The interface locale: `en`, `ur`, `ar`. Sized as `User.locale` is.
  locale String @db.NVarChar(8)

  /// CASCADE, and it is the only cascade path into this table. A topic is never
  /// deleted at runtime, so this describes what a reviewed rollback does rather
  /// than anything an administrator can cause.
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  name        String  @db.NVarChar(200)
  description String? @db.NVarChar(500)

  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  @@id([topicId, locale])
  @@map("TopicTranslation")
}

/// A CONTENT language — what a work is written in (DOMAIN_MODEL.md §6.3).
///
/// NOT THE INTERFACE LOCALE, and structurally incapable of becoming it. Nothing
/// relates this table to `TopicTranslation`, to `User.locale` or to the
/// next-intl routing configuration, and administering a row here changes no
/// interface behaviour whatsoever. The UI may be English while the content is
/// Urdu; conflating the two is the damaging modelling error §6.3 warns about.
///
/// THE CODE IS THE PRIMARY KEY. A language's identity IS its code — `ur` is
/// what a filter, an import and a citation will carry — and a surrogate id
/// would let two rows claim the same one.
///
/// `direction` IS DOMAIN DATA. A title in Urdu renders right-to-left inside an
/// English page, and only the content language can say so.
model Language {
  editions Edition[]
  pageTranslations PageRevisionTranslation[]
  researches Research[]
  researchPapers ResearchPaper[]
  publications Publication[]
  magazineIssues MagazineIssue[]
  encyclopedias Encyclopedia[]
  videos Video[]
  audioTracks AudioTrack[]

  articleTranslations ArticleRevisionTranslation[]
  newsArticleTranslations NewsArticleRevisionTranslation[]
  eventTranslations EventRevisionTranslation[]
  collectionTranslations CollectionRevisionTranslation[]
  pressReleaseTranslations PressReleaseRevisionTranslation[]
  statementTranslations StatementRevisionTranslation[]
  mediaCoverageTranslations MediaCoverageRevisionTranslation[]
  quranTranslations QuranTranslation[]
  hadithBookTitles   HadithBook[]        @relation("HadithBookTitleLanguage")
  hadithChapterTitles HadithChapter[]    @relation("HadithChapterTitleLanguage")
  hadithTexts        Hadith[]            @relation("HadithTextLanguage")
  hadithChains       Hadith[]            @relation("HadithChainLanguage")
  hadithGradings     HadithGrading[]     @relation("HadithGradingLanguage")
  hadithTranslations HadithTranslation[] @relation("HadithTranslationLanguage")
  hadithCommentaries HadithCommentary[]  @relation("HadithCommentaryLanguage")
  hadithScienceTexts HadithScienceText[] @relation("HadithScienceTextLanguage")
  fatwaRevisions FatwaRevision[]
  quranTransliterations QuranTransliteration[]
  quranTafsirs QuranTafsir[]
  quranTajweedTexts QuranTajweedRuleText[]
  courses Course[]

  code String @id @db.NVarChar(16)

  englishName String @db.NVarChar(120)

  /// The language's name in its own script. Required: a catalogue that can only
  /// name a language in English is unusable to the readers it exists for.
  nativeName String @db.NVarChar(120)

  /// ltr | rtl
  direction String @db.NVarChar(3)

  /// active | retired. Retired rather than deleted: a work recorded in a
  /// language stays true after the organisation stops publishing in it.
  status String @db.NVarChar(16)

  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  @@map("Language")
}

/// A free-form editorial label (DOMAIN_MODEL.md §6.4).
///
/// EVERYTHING A TOPIC HAS THAT THIS DOES NOT is the point of the model. No
/// parent, no ordering, no translation table, no `system` flag, no canonical
/// guarantee — because a Tag is an editorial convenience and a Topic is the
/// curated vocabulary the platform navigates by. A tag that acquired a parent
/// would be a second, unreviewed taxonomy competing with the real one.
///
/// THE SLUG EXISTS FOR IDENTITY, NOT FOR CANONICITY. It is what makes "the same
/// tag" mean something under concurrency: two editors typing the same label
/// produce one row. It promises nothing else.
model Tag {
  id String @id @default(dbgenerated("CONVERT(nvarchar(36), NEWID())")) @db.NVarChar(36)

  slug  String @unique @db.NVarChar(120)
  label String @db.NVarChar(120)

  /// active | retired
  status String @db.NVarChar(16)

  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  /// The bounded administrative listing seeks on status and searches by slug or
  /// label prefix, ordered by slug. Tags are the one table here that genuinely
  /// grows, so both prefix paths are indexed rather than left to a scan.
  @@index([status, slug])
  @@index([status, label])
  @@map("Tag")
}

// ===========================================================================
// Phase 5 — People & Contributors
// ===========================================================================
//
// OWNERSHIP. Physical placement here transfers no semantic ownership
// (ARCHITECTURE.md §4.1, §6.3 rule 14). Every table below is owned by the
// PEOPLE & CONTRIBUTORS context, declared in this package's manifest under
// `minhaj.persistenceAdapters`, and the architecture gate fails closed on an
// adapter no declaration owns.
//
// SIX DISTINCT MODELS, AND THEY ARE NEVER MERGED. DOMAIN_MODEL.md §5.2 states
// it as a rule: "Person, AuthorProfile, SpeakerProfile, ScholarProfile,
// TeacherProfile and User are six distinct models and are never merged."
//
// So there is deliberately NO `Profile` table with a `type` column, NO
// `isAuthor`/`isTeacher` boolean on `Person`, and NO merge of `Person` into
// `User`. Four separate tables cost four unique indexes and buy four
// independent lifecycles — a person's author facet stays visible while their
// teacher facet is withdrawn, and neither transition can touch the other by
// sharing a row with it.
//
// NO CAPABILITY IS STORED ANYWHERE IN THIS SECTION. `canTeach`,
// `canReceiveQuestions`, `canReviewContent` and `canIssueFatwa` are projections
// of Identity grants (§4.5); the closest thing to one of them here is the
// ABSENCE of a column, which is the point. "A profile alone grants nothing",
// and a schema with nowhere to record the opposite is how that stays true.
//
// NO CONTRIBUTION JUNCTION. §5.3 puts the relationship row in the context that
// owns the TARGET, and no such context has shipped. The role VOCABULARY is
// `CONTRIBUTION_ROLES` in `packages/contracts/src/people/values.ts`; there is
// no table here for a `targetType` + `targetId` pair to live in, which is what
// §6.2 prohibits and what a "generic contribution" table would be.
//
// NO TAXONOMY REFERENCE. People's allowlist row is "Layer 0; Identity & Access"
// (§3.1), so nothing below carries a foreign key to `Topic` or `Language`.
// Profile languages are scalar BCP-47 style codes validated by a People-owned
// schema, which is a duplication chosen deliberately over an architecture edge.
//
// NO IMAGE, NO ASSET, NO URL. Storage arrives at Phase 7 and profile media with
// the phase that owns it. A portrait column added now would either be an
// unowned blob or an authoritative external reference nobody reviewed.
//
// NO HARD DELETE for the aggregates. `Person` and the four profiles are
// archived, never removed, and the runtime principal holds no DELETE on any of
// them — so a later content context's typed contributor reference can never be
// orphaned by an administrator pressing a button. The CHILD rows (translations,
// name variants, profile languages) ARE deletable, because removing a
// translation entered in error is a real administrative act and blanking it to
// an empty string would be a translation that exists and says nothing.

/// A human being who contributes to the platform's content
/// (DOMAIN_MODEL.md §5.1).
///
/// A PUBLIC RECORD, AND NOT AN ACCOUNT. "It exists for historical figures with
/// no account, and for contributors who have never signed in." The link to
/// `User` is optional in both directions and is private; nothing about an
/// account reaches a public surface through this table.
///
/// THE SLUG IS IMMUTABLE. DOMAIN_MODEL.md §19.7 permits an editable canonical
/// slug only with native slug history and automatic 301s delivered by the same
/// phase. Phase 5 delivers neither, so it takes the other branch: the slug is
/// fixed at creation and the runtime principal is DENIED UPDATE on the column,
/// exactly as it is on `Topic.slug`. A stable public URL is then a property of
/// the grant rather than of a rule somebody remembered.
model Person {
  workContributions WorkContributor[]
  bookTranslations BookTranslator[]
  pageContributions PageContributor[]
  researchContributions ResearchContributor[]
  researchPaperContributions ResearchPaperContributor[]
  publicationContributions PublicationContributor[]
  magazineContributions MagazineContributor[]
  magazineIssueContributions MagazineIssueContributor[]
  encyclopediaContributions EncyclopediaContributor[]
  videoSpeakers VideoSpeaker[]
  audioTrackSpeakers AudioTrackSpeaker[]

  articleContributions ArticleContributor[]
  newsArticleContributions NewsArticleContributor[]
  eventContributions EventContributor[]
  collectionContributions CollectionContributor[]
  pressReleaseContributions PressReleaseContributor[]
  statementContributions StatementContributor[]
  mediaCoverageContributions MediaCoverageContributor[]
  quranTranslationContributions QuranTranslationContributor[]
  hadithTranslationContributions HadithTranslationContributor[]
  hadithCommentaryContributions  HadithCommentaryContributor[]
  fatwaPublicationsPublished     FatwaPublication[] @relation("FatwaPublicationPublisherPerson")
  fatwaPublicationsAuthored      FatwaPublication[] @relation("FatwaPublicationAuthorPerson")
  quranTafsirContributions QuranTafsirContributor[]
  quranRecitations QuranRecitation[]
  courseTeachers CourseTeacher[]

  id String @id @default(dbgenerated("CONVERT(nvarchar(36), NEWID())")) @db.NVarChar(36)

  /// Stable, globally unique, URL-safe public identity. `/people/{slug}` is the
  /// canonical contributor route (ROUTE_MAP.md §2.1), so uniqueness is global.
  ///
  /// NOT DERIVED FROM A NAME. The name is localised and frequently written in a
  /// non-Latin script; a slug transliterated from it would depend on who
  /// transliterated it.
  slug String @unique @db.NVarChar(160)

  /// The OPTIONAL account link (DOMAIN_MODEL.md §5.1).
  ///
  /// UNIQUE, WHICH IS WHAT MAKES IT ONE-TO-ONE. Without the unique index two
  /// concurrent administrators could each attach the same account to a
  /// different Person and both succeed; with it, exactly one does and the other
  /// is refused by the database rather than by whichever check ran first.
  ///
  /// NO ACTION ON DELETE, deliberately, and not a cascade nobody configured.
  /// Account closure RETAINS the `User` row — pseudonymised, with a tombstone
  /// address (§4.6) — so there is no delete for a cascade to follow. If one
  /// ever occurred, a cascade would destroy a PUBLIC contributor record because
  /// a private account disappeared, inverting the ownership this model rests on.
  ///
  /// WHAT CLOSURE ACTUALLY DOES to this column is release it: People removes
  /// its own link through its own service after Identity commits. That is the
  /// settled product default: the public Person survives, while the operational
  /// account association does not. Any future historical association needs an
  /// explicit retention/provenance mechanism; this comment makes no universal
  /// legal-basis claim (DOMAIN_MODEL.md §5.4; SECURITY_BASELINE.md §19.1).
  userId String? @unique @db.NVarChar(36)
  user   User?   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// The interface locale this Person's content was originally written in.
  ///
  /// NOT ASSUMED TO BE ENGLISH, and that is the whole reason it is stored.
  /// ROUTE_MAP.md §9.2.1 resolves `x-default` to the ORIGINAL language when no
  /// English version exists, and much of this corpus is Urdu-original or
  /// Arabic-original. A platform that defaulted the answer would advertise an
  /// English URL for a person who has no English version.
  ///
  /// It is an INTERFACE locale, not a content `Language`: these are the three
  /// languages the platform's own pages are read in, which is what a `hreflang`
  /// alternate has to name.
  primaryLocale String @db.NVarChar(8)

  /// draft | published | archived. Only `published` is publicly visible, and
  /// the visibility predicate lives in the query rather than in the page.
  status String @db.NVarChar(16)

  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  translations PersonTranslation[]
  nameVariants PersonNameVariant[]

  /// The four facets. Each is OPTIONAL and each is its own aggregate: a Person
  /// may hold all four at once, in any combination, with four independent
  /// lifecycles (DOMAIN_MODEL.md §5.2).
  authorProfile  AuthorProfile?
  speakerProfile SpeakerProfile?
  scholarProfile ScholarProfile?
  teacherProfile TeacherProfile?

  /// The administrative directory seeks on status and orders by slug, which is
  /// unique — so the ordering is TOTAL and a page boundary can neither repeat a
  /// row nor skip one.
  @@index([status, slug])
  /// The sitemap and the public reader both ask for published people ordered by
  /// their last genuine modification.
  @@index([status, updatedAt])
  @@map("Person")
}

/// A Person's name and biography in ONE INTERFACE LOCALE.
///
/// TRANSLATION ROWS, NOT PARALLEL COLUMNS. DOMAIN_MODEL.md §19.1 is explicit:
/// locale-aware fields are rows related to the parent record, never
/// `name_en`/`name_ur`. Adding a fourth interface locale is then a data
/// operation, and a missing translation is detectable by a query — which is
/// exactly what the public route needs, because it must omit a locale from
/// `hreflang` rather than advertise a fallback as a translation
/// (ROUTE_MAP.md §9.2).
///
/// ONE ROW PER (PERSON, LOCALE), by the composite primary key. Two editors
/// saving the Urdu name at once produce one row, and neither had to read first
/// to find out.
///
/// THE PRIMARY-LOCALE TRANSLATION CANNOT BE REMOVED. `PeoplePersonPrimaryName`
/// refuses any delete or update that would leave a Person without a translation
/// in their own primary locale, so resolving a Person always yields a real name
/// in a real language — and the canonical URL always points at a genuine
/// language version rather than at a fallback (§9.3).
model PersonTranslation {
  personId String @db.NVarChar(36)

  /// The interface locale: `en`, `ur`, `ar`. Sized as `User.locale` is.
  locale String @db.NVarChar(8)

  /// CASCADE, and it is one of several cascade paths inside this context. A
  /// Person is never deleted at runtime, so this describes what a reviewed
  /// rollback does rather than anything an administrator can cause.
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  name String @db.NVarChar(200)

  /// Optional, and empty means absent. A contributor record with no biography
  /// is the normal case — a historical author may be nothing but a name — and a
  /// required column would be filled with invented prose about a real person
  /// (OPEN_DECISIONS.md §6.3).
  biography String? @db.NVarChar(4000)

  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  /// The administrative directory searches contributors by name PREFIX, and an
  /// unindexed predicate over a table that grows with every contributor in
  /// every language is a scan on every keystroke. `startsWith` is what an index
  /// can seek; a `contains` search would be a leading wildcard and could not
  /// use this index at all, which is why the query does not offer one.
  @@index([name])
  @@id([personId, locale])
  @@map("PersonTranslation")
}

/// An alternative way one Person's name is written, in one locale.
///
/// A ROW AND NOT A DELIMITED COLUMN. A historical author is routinely known by
/// several names, and the public profile lists them. A comma-separated string
/// is a list the database cannot count, cannot index and cannot de-duplicate,
/// so all three jobs would move into application code where a concurrent writer
/// can step around them.
///
/// DE-DUPLICATION IS ON THE NORMALISED FORM, WHICH IS STORED.
/// `normaliseNameVariant` case-folds and collapses whitespace after NFC, and
/// nothing else — no transliteration and no diacritic stripping, because
/// removing the diacritics from a name written in Arabic script can change
/// which name it is. The normalised value has its own column so the unique
/// index is over the value actually compared; an application that normalised at
/// write time and indexed the raw value would enforce a different rule from the
/// one it documents.
///
/// COUNT-BOUNDED BY A TRIGGER, not by the writer. `PeopleNameVariantBound`
/// refuses the insert that would exceed the accepted per-locale maximum, so two
/// concurrent adds cannot both observe a count below the bound and commit past
/// it.
model PersonNameVariant {
  id String @id @default(dbgenerated("CONVERT(nvarchar(36), NEWID())")) @db.NVarChar(36)

  personId String @db.NVarChar(36)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  locale String @db.NVarChar(8)

  /// As entered, and as displayed. The reader sees what an editor typed.
  value String @db.NVarChar(200)

  /// As compared. Never displayed.
  normalised String @db.NVarChar(200)

  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  @@unique([personId, locale, normalised])
  @@map("PersonNameVariant")
}

/// A writer of works (DOMAIN_MODEL.md §5.2).
///
/// "May be historical; no longer owned by Library." That last clause is why
/// this table exists at Phase 5 rather than at Phase 8: the prior revision let
/// `books` own Author, which left Speaker unowned and authorship duplicated
/// across contexts. Author is delivered exactly once, before its consumers
/// (DELIVERY_PLAN.md, Phase 5 exit).
///
/// NO FIELDS OF ITS OWN, AND THAT IS NOT AN OVERSIGHT. §5.2 names none for
/// Author, so none is invented. It is a distinct aggregate because it has a
/// distinct MEANING and a distinct LIFECYCLE — not because it has distinct
/// columns, and adding a field apiece to make the four tables look symmetrical
/// would be modelling by table layout.
model AuthorProfile {
  id String @id @default(dbgenerated("CONVERT(nvarchar(36), NEWID())")) @db.NVarChar(36)

  /// UNIQUE: at most one author facet per Person. Four tables, four unique
  /// indexes — which is what makes "one Person may hold all four" and "one
  /// Person may hold each at most once" both properties of the schema.
  personId String @unique @db.NVarChar(36)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  /// draft | active | archived. Its OWN lifecycle, independent of the Person's
  /// and of the other three facets'.
  status String @db.NVarChar(16)

  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  @@map("AuthorProfile")
}

/// A speaker in video or audio (DOMAIN_MODEL.md §5.2).
///
/// "Explicitly owned here — previously unowned." Media and Learning will
/// reference a speaker through this boundary rather than growing their own
/// notion of one.
///
/// NO FIELDS OF ITS OWN, for the same reason `AuthorProfile` has none.
model SpeakerProfile {
  id String @id @default(dbgenerated("CONVERT(nvarchar(36), NEWID())")) @db.NVarChar(36)

  personId String @unique @db.NVarChar(36)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  status String @db.NVarChar(16)

  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  @@map("SpeakerProfile")
}

/// A public scholarly profile (DOMAIN_MODEL.md §5.2).
///
/// "Qualifications, expertise, languages" — the three concerns §5.2's own table
/// names, and the reason this aggregate has child rows where Author and Speaker
/// have none.
///
/// IT ESTABLISHES NO RELIGIOUS AUTHORITY. A ScholarProfile is a description,
/// not an appointment: issuing a Fatwa requires the `fatwa.publish` grant,
/// which no phase has yet made grantable and which OPEN_DECISIONS.md §6.3
/// reserves to the organisation. Nothing in this table can confer it, and
/// nothing reads it to decide anything.
///
/// ITS QUALIFICATIONS ARE NOT VERIFIED BY THIS PLATFORM. There is no
/// verification workflow, no evidence upload and no awarding body, because
/// inventing one would be inventing a credential-verification product nobody
/// asked for. The field records what an authorised administrator entered.
model ScholarProfile {
  id String @id @default(dbgenerated("CONVERT(nvarchar(36), NEWID())")) @db.NVarChar(36)

  personId String @unique @db.NVarChar(36)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  status String @db.NVarChar(16)

  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  translations ScholarProfileTranslation[]
  languages    ScholarProfileLanguage[]

  @@map("ScholarProfile")
}

/// One scholar profile's qualifications and expertise in ONE interface locale.
///
/// LOCALISED, because these are prose a reader reads, and a trilingual platform
/// that stored them once would show Urdu readers an English paragraph.
///
/// FREE TEXT RATHER THAN A STRUCTURED EXPERTISE LIST, and the reason is an
/// ownership boundary. A structured subject vocabulary is a taxonomy; Taxonomy
/// owns taxonomies; People may not depend on Taxonomy (§3.1). Growing a second
/// subject vocabulary here would be the shadow taxonomy that boundary exists to
/// prevent, and the typed link between a scholar and a Topic belongs to the
/// context that owns the target when one ships (§6.2).
model ScholarProfileTranslation {
  scholarProfileId String         @db.NVarChar(36)
  scholarProfile   ScholarProfile @relation(fields: [scholarProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  locale String @db.NVarChar(8)

  /// Optional, and empty is absent. An unentered qualification must read as
  /// "nothing is recorded", never as an empty claim.
  qualifications String? @db.NVarChar(2000)
  expertise      String? @db.NVarChar(2000)

  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  @@id([scholarProfileId, locale])
  @@map("ScholarProfileTranslation")
}

/// One content language a scholar works in.
///
/// A SCALAR CODE, NOT A FOREIGN KEY. Taxonomy owns the administered `Language`
/// catalogue and People may not depend on Taxonomy, so this stores a validated
/// BCP-47 style code and claims nothing about a catalogue row.
///
/// ITS OWN TABLE, NOT SHARED WITH `TeacherProfileLanguage`. One table serving
/// both would need a column saying which kind of profile the row belongs to,
/// and that column is the polymorphic reference §6.2 prohibits. Two small
/// tables with real foreign keys cost a duplicated shape and buy referential
/// integrity the database enforces.
model ScholarProfileLanguage {
  scholarProfileId String         @db.NVarChar(36)
  scholarProfile   ScholarProfile @relation(fields: [scholarProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  /// Lowercase, as `contributorLanguageCodeSchema` normalises it, so the
  /// composite key treats one language as one row.
  languageCode String @db.NVarChar(16)

  @@id([scholarProfileId, languageCode])
  @@map("ScholarProfileLanguage")
}

/// An approved teacher (DOMAIN_MODEL.md §5.2).
///
/// "Teaching subjects, languages, public biography" — §5.2's own three
/// concerns.
///
/// "APPROVED" IS NOT WHAT THIS ROW MEANS, and the distinction is the single
/// most important one in this file. §4.5: "Creating a Teacher profile confers
/// no teaching privilege; teacher approval must create an auditable
/// RoleAssignment." An `active` TeacherProfile says a teaching facet has been
/// described and may be shown. `canTeach` comes from the `teaching.perform`
/// grant and from nowhere else, and this table has no column that could
/// disagree with it.
///
/// NO SAFEGUARDING STATE, NO VETTING, NO MINOR-ELIGIBILITY FLAG. Those belong
/// to Phases 23–25 behind an external safeguarding gate (DELIVERY_PLAN.md), and
/// a default-deny field invented here would be policy this project has not been
/// given.
model TeacherProfile {
  id String @id @default(dbgenerated("CONVERT(nvarchar(36), NEWID())")) @db.NVarChar(36)

  personId String @unique @db.NVarChar(36)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  status String @db.NVarChar(16)

  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  translations TeacherProfileTranslation[]
  languages    TeacherProfileLanguage[]

  @@map("TeacherProfile")
}

/// One teacher profile's public biography and subjects in ONE interface locale.
///
/// A SEPARATE BIOGRAPHY FROM THE PERSON'S, because §5.2 names one for this
/// aggregate specifically: what a teacher tells a prospective student is not
/// the same text as the contributor biography that heads the profile, and
/// collapsing the two would make editing one change the other.
model TeacherProfileTranslation {
  teacherProfileId String         @db.NVarChar(36)
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  locale String @db.NVarChar(8)

  biography String? @db.NVarChar(2000)
  subjects  String? @db.NVarChar(2000)

  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  @@id([teacherProfileId, locale])
  @@map("TeacherProfileTranslation")
}

/// One content language a teacher teaches in.
///
/// Its own table for the same reason `ScholarProfileLanguage` is: a shared one
/// would need a discriminator column, and that column is the polymorphic
/// reference DOMAIN_MODEL.md §6.2 prohibits.
model TeacherProfileLanguage {
  teacherProfileId String         @db.NVarChar(36)
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

