model AudioTrackTopic {
  trackId String @db.NVarChar(36)
  topicId String @db.NVarChar(36)
  track AudioTrack @relation(fields: [trackId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([trackId, topicId])
  @@index([topicId, trackId])
}

/// An ordered run of AudioTracks. Removing or archiving it removes no track.
model AudioSeries {
  id String @id @db.NVarChar(36)
  slug String @unique @db.NVarChar(120)
  primaryLocale String @db.NVarChar(8)
  state String @db.NVarChar(16)
  version Int @default(1)
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  labels AudioSeriesLabel[]
  slugs AudioSeriesSlugHistory[]
  tracks AudioTrack[]
  @@index([state, slug])
}

model AudioSeriesLabel {
  seriesId String @db.NVarChar(36)
  locale String @db.NVarChar(8)
  title String @db.NVarChar(240)
  description String @db.NVarChar(4000)
  series AudioSeries @relation(fields: [seriesId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([seriesId, locale])
}

model AudioSeriesSlugHistory {
  slug String @id @db.NVarChar(120)
  seriesId String @db.NVarChar(36)
  series AudioSeries @relation(fields: [seriesId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([seriesId])
}

// ===========================================================================
// Phase 12 — Media: Photo, Gallery, GalleryItem (DOMAIN_MODEL.md §11)
// ===========================================================================
//
// THREE SHAPES. A Photo is one logical photograph whose image is a Storage
// Asset, reached by ONE typed, nullable foreign key that never cascades. A
// Gallery is a curated grouping with its own slug namespace and history. A
// GalleryItem is a Photo's place in a Gallery: typed, ordered, duplicate-free
// and bounded, with no lifecycle of its own.
//
// NO EVENT, NO CENTRE, NO COLLECTION. Nothing below references an Event or
// reserves a column for one: Phase 14 owns the typed Event↔Gallery association
// once both exist. No generic media item, image, album or asset-link table, and
// no `targetType + targetId` pair.
//
// A PHOTO HAS NO SLUG. It has no public page of its own (ROUTE_MAP.md §3.9).

/// One logical photograph. Its bytes are Storage's; its meaning is Media's.
model Photo {
  id String @id @db.NVarChar(36)
  primaryLocale String @db.NVarChar(8)
  state String @db.NVarChar(16)
  /// How the photograph is credited. Descriptive text, never a licence.
  credit String? @db.NVarChar(200)
  /// When it was taken, as precisely as it is KNOWN: a year, optionally a
  /// month, optionally a day. Never derived from `createdAt`.
  takenYear Int?
  takenMonth Int?
  takenDay Int?
  /// The ONE Storage asset holding the image, or none yet. A published Photo
  /// must have one (a CHECK), and one asset serves at most one Photo (a
  /// FILTERED unique index the migration creates).
  assetId String? @db.NVarChar(36)
  /// The image's DISPLAYED size, recorded with the asset and only with it.
  width Int?
  height Int?
  version Int @default(1)
  /// When the RECORD was created — the order of "recently added", never a
  /// historical date.
  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  asset Asset? @relation("PhotoAsset", fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  labels PhotoLabel[]
  galleries GalleryItem[]
  @@index([state, createdAt, id])
  @@index([state, takenYear, takenMonth, takenDay])
}

/// A Photo's alternative text and caption in one interface locale.
model PhotoLabel {
  photoId String @db.NVarChar(36)
  locale String @db.NVarChar(8)
  altText String? @db.NVarChar(500)
  caption String? @db.NVarChar(1000)
  photo Photo @relation(fields: [photoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([photoId, locale])
}

/// A curated, ordered grouping of Photos. Removing one removes no Photo.
model Gallery {
  id String @id @db.NVarChar(36)
  slug String @unique @db.NVarChar(120)
  primaryLocale String @db.NVarChar(8)
  state String @db.NVarChar(16)
  version Int @default(1)
  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  labels GalleryLabel[]
  slugs GallerySlugHistory[]
  items GalleryItem[]
  eventAssociations EventGallery[]
  @@index([state, createdAt, id])
}

model GalleryLabel {
  galleryId String @db.NVarChar(36)
  locale String @db.NVarChar(8)
  title String @db.NVarChar(240)
  description String @db.NVarChar(4000)
  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([galleryId, locale])
}

model GallerySlugHistory {
  slug String @id @db.NVarChar(120)
  galleryId String @db.NVarChar(36)
  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([galleryId])
}

/// One Photo's place in one Gallery. Unique per Gallery, densely ordered, and
/// bounded to 240 places by a CHECK on the position.
model GalleryItem {
  galleryId String @db.NVarChar(36)
  photoId String @db.NVarChar(36)
  position Int
  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  photo Photo @relation(fields: [photoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([galleryId, photoId])
  @@unique([galleryId, position])
  @@index([photoId, galleryId])
}

// ===========================================================================
// Phase 17 — Search Foundation (Layer 0 infrastructure, NOT a bounded context)
// ===========================================================================
//
// DERIVED STATE ONLY. Nothing below is authoritative for any business fact:
// publication, visibility, slugs, titles and topics belong to Taxonomy, People &
// Contributors, Editorial and Library. The projection is rebuilt from those
// owners' public reads and is never restored as truth (ARCHITECTURE.md §8.5).
//
// `scopeKind + scopeId` IS DELIBERATELY NOT A FOREIGN KEY. It names an owner's
// resource inside a DERIVED index, which is outside the prohibition on
// polymorphic relational domain references (DOMAIN_MODEL.md §6.2): no business
// relation is expressed through it, no owner reads it, and deleting it loses
// nothing a rebuild cannot recreate. A typed FK from here to every owner table
// would instead make Search a dependant of every context it indexes.
//
// THE FULL-TEXT CATALOGUE AND INDEX are created by the migration's SQL, which
// Prisma's schema language cannot express. They sit on
// `SearchDocument.match*`, one column per word breaker.

/// One owner's request that a scope be re-projected (ARCHITECTURE.md §8.5).
///
/// APPEND-ONLY, WRITTEN INSIDE THE OWNER'S OWN TRANSACTION. An owner commits its
/// change and this row together, so indexing intent can never be lost between
/// the two — and the owner's transaction does nothing to Search's working state,
/// which the indexer folds these rows into later. An INSERT at the end of an
/// identity key is the cheapest, least contended write an owner could be asked
/// to add to its own transaction.
model SearchIndexRequest {
  id          BigInt   @id @default(autoincrement())
  scopeKind   String   @db.NVarChar(16)
  scopeId     String   @db.NVarChar(36)
  requestedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  @@map("SearchIndexRequest")
}

/// The indexing state of one scope: pending, current or failed.
///
/// `generation` moves on every relayed request. A worker settles a scope as
/// current only if the generation it projected is still the latest, so a change
/// committed while a projection was being built is never marked done.
model SearchIndexScope {
  scopeKind       String    @db.NVarChar(16)
  scopeId         String    @db.NVarChar(36)
  /// pending | current | failed
  status          String    @db.NVarChar(16)
  generation      Int
  attempts        Int
  dueAt           DateTime  @db.DateTime2
  /// When the oldest unprocessed request for this scope was made.
  requestedAt     DateTime? @db.DateTime2
  leaseToken      String?   @db.NVarChar(36)
  leaseUntil      DateTime? @db.DateTime2
  indexedAt       DateTime? @db.DateTime2
  indexedStamp    String?   @db.NVarChar(64)
  failureCategory String?   @db.NVarChar(32)
  failedAt        DateTime? @db.DateTime2

  documents SearchDocument[]

  @@id([scopeKind, scopeId])
  /// The claim reads due work oldest first; the operator view counts by status.
  @@index([status, dueAt, scopeKind, scopeId])
  @@map("SearchIndexScope")
}

/// One searchable document — one owner resource in one text language.
///
/// `id` is a narrow integer because SQL Server's full-text KEY INDEX must be a
/// unique, single, non-nullable column, and a small key is what every full-text
/// match is joined back through.
model SearchDocument {
  id              Int      @id @default(autoincrement())
  scopeKind       String   @db.NVarChar(16)
  scopeId         String   @db.NVarChar(36)
  kind            String   @db.NVarChar(24)
  resourceId      String   @db.NVarChar(36)
  textLanguage    String   @db.NVarChar(16)
  contentLanguage String?  @db.NVarChar(16)
  title           String   @db.NVarChar(300)
  summary         String   @db.NVarChar(600)
  /// Exactly one of the four is set, chosen by `textLanguage` (CHECK constraint).
  matchEnglish    String?  @db.NVarChar(Max)
  matchArabic     String?  @db.NVarChar(Max)
  matchUrdu       String?  @db.NVarChar(Max)
  matchOther      String?  @db.NVarChar(Max)
  year            Int?     @db.SmallInt
  checksum        String   @db.Char(64)
  indexedAt       DateTime @db.DateTime2

  scope  SearchIndexScope      @relation(fields: [scopeKind, scopeId], references: [scopeKind, scopeId], onDelete: NoAction, onUpdate: NoAction)
  topics SearchDocumentTopic[]

  @@unique([kind, resourceId, textLanguage])
  @@index([scopeKind, scopeId])
  @@map("SearchDocument")
}

/// A document's canonical Topic identifiers, for the topic filter.
///
/// NO FOREIGN KEY TO `Topic`, for the reason the header gives: this is a derived
/// copy of the owner's own typed assignment, rebuilt with the document.
model SearchDocumentTopic {
  documentId Int
  topicId    String @db.NVarChar(36)

  document SearchDocument @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([documentId, topicId])
  @@index([topicId, documentId])
  @@map("SearchDocumentTopic")
}

// =============================================================================
// Phase 16 — Global Network: Country, Region, City, Centre, CentreContact
// =============================================================================
//
// FLEXIBLE PARENTAGE (DOMAIN_MODEL.md §17.1). A Region belongs to a Country; a
// City belongs to a Country and, only where one is meaningful, to a Region of
// THAT Country; a Centre belongs to a Country and, where it has one, to a
// physical City or — with no City — directly to a Region. The SAME-COUNTRY rule
// is carried by every relation: each parent reference is a composite foreign
// key on `(id, countryId)`, so a child can never name a parent in another
// Country, whoever writes.
//
// ONE LOCALITY FACT. A Centre with a City takes its Region from that City and
// stores none of its own, so the two can never disagree.
//
// A Centre SERVES further Cities through a typed, same-Country relation, and
// carries its own optional address words and coordinates. Contacts are public
// directory facts. No Event, map, geocoder or search table exists here.

/// A Country: the one level every place belongs to.
model Country {
  id            String               @id @db.NVarChar(36)
  /// ISO 3166-1 alpha-2, upper case: the Country's canonical identity.
  code          String               @unique @db.NVarChar(2)
  slug          String               @unique @db.NVarChar(120)
  primaryLocale String               @db.NVarChar(8)
  state         String               @db.NVarChar(16)
  version       Int                  @default(1)
  createdAt     DateTime             @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt     DateTime             @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  labels        CountryLabel[]
  slugs         CountrySlugHistory[]
  regions       Region[]
  cities        City[]
  centres       Centre[]

  @@index([state, slug, id])
}

model CountryLabel {
  countryId String  @db.NVarChar(36)
  locale    String  @db.NVarChar(8)
  name      String  @db.NVarChar(160)
  country   Country @relation(fields: [countryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([countryId, locale])
}

model CountrySlugHistory {
  slug      String  @id @db.NVarChar(120)
  countryId String  @db.NVarChar(36)
  country   Country @relation(fields: [countryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([countryId])
}

/// A Region of one Country. Its Country never changes after creation.
model Region {
  id            String              @id @db.NVarChar(36)
  countryId     String              @db.NVarChar(36)
  slug          String              @db.NVarChar(120)
  primaryLocale String              @db.NVarChar(8)
  state         String              @db.NVarChar(16)
  version       Int                 @default(1)
  createdAt     DateTime            @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt     DateTime            @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  country       Country             @relation(fields: [countryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  labels        RegionLabel[]
  slugs         RegionSlugHistory[]
  cities        City[]
  centres       Centre[]

  @@unique([countryId, slug])
  @@unique([id, countryId])
  @@index([countryId, state, slug, id])
}

model RegionLabel {
  regionId String @db.NVarChar(36)
  locale   String @db.NVarChar(8)
  name     String @db.NVarChar(160)
  region   Region @relation(fields: [regionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([regionId, locale])
}

/// A Region's slugs, reserved within its Country for good.
model RegionSlugHistory {
  countryId String @db.NVarChar(36)
  slug      String @db.NVarChar(120)
  regionId  String @db.NVarChar(36)
  region    Region @relation(fields: [regionId, countryId], references: [id, countryId], onDelete: NoAction, onUpdate: NoAction)

  @@id([countryId, slug])
  @@index([regionId])
}

/// A City of one Country and, where meaningful, of one Region of that Country.
/// Its Country never changes after creation; its Region may, within it.
model City {
  id            String              @id @db.NVarChar(36)
  countryId     String              @db.NVarChar(36)
  regionId      String?             @db.NVarChar(36)
  slug          String              @db.NVarChar(120)
  primaryLocale String              @db.NVarChar(8)
  state         String              @db.NVarChar(16)
  version       Int                 @default(1)
  createdAt     DateTime            @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt     DateTime            @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  country       Country             @relation(fields: [countryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  region        Region?             @relation(fields: [regionId, countryId], references: [id, countryId], onDelete: NoAction, onUpdate: NoAction)
  labels        CityLabel[]
  slugs         CitySlugHistory[]
  centres       Centre[]
  servedBy      CentreServiceCity[]

  @@unique([countryId, slug])
  @@unique([id, countryId])
  @@index([countryId, state, slug, id])
  @@index([regionId, state, slug, id])
}

model CityLabel {
  cityId String @db.NVarChar(36)
  locale String @db.NVarChar(8)
  name   String @db.NVarChar(160)
  city   City   @relation(fields: [cityId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([cityId, locale])
}

/// A City's slugs, reserved within its Country for good.
model CitySlugHistory {
  countryId String @db.NVarChar(36)
  slug      String @db.NVarChar(120)
  cityId    String @db.NVarChar(36)
  city      City   @relation(fields: [cityId, countryId], references: [id, countryId], onDelete: NoAction, onUpdate: NoAction)

  @@id([countryId, slug])
  @@index([cityId])
}

/// A Centre: physical or explicitly virtual, with its own address words and
/// optional genuine coordinates (exact decimals, never binary floating point).
model Centre {
  id            String                @id @db.NVarChar(36)
  slug          String                @unique @db.NVarChar(120)
  countryId     String                @db.NVarChar(36)
  regionId      String?               @db.NVarChar(36)
  cityId        String?               @db.NVarChar(36)
  isVirtual     Boolean               @default(false)
  latitude      Decimal?              @db.Decimal(9, 6)
  longitude     Decimal?              @db.Decimal(9, 6)
  primaryLocale String                @db.NVarChar(8)
  state         String                @db.NVarChar(16)
  version       Int                   @default(1)
  createdAt     DateTime              @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt     DateTime              @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  country       Country               @relation(fields: [countryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  region        Region?               @relation(fields: [regionId, countryId], references: [id, countryId], onDelete: NoAction, onUpdate: NoAction)
  city          City?                 @relation(fields: [cityId, countryId], references: [id, countryId], onDelete: NoAction, onUpdate: NoAction)
  labels        CentreLabel[]
  slugs         CentreSlugHistory[]
  serves        CentreServiceCity[]
  contacts      CentreContact[]
  newsRevisions NewsArticleRevision[]
  eventRevisions EventRevision[]

  @@unique([id, countryId])
  @@index([countryId, state, slug, id])
  @@index([cityId, state])
  @@index([regionId, state])
  @@index([state, slug, id])
}

model CentreLabel {
  centreId    String  @db.NVarChar(36)
  locale      String  @db.NVarChar(8)
  name        String  @db.NVarChar(200)
  description String? @db.NVarChar(2000)
  address     String? @db.NVarChar(500)
  centre      Centre  @relation(fields: [centreId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([centreId, locale])
}

model CentreSlugHistory {
  slug     String @id @db.NVarChar(120)
  centreId String @db.NVarChar(36)
  centre   Centre @relation(fields: [centreId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([centreId])
}

/// A further City a Centre serves: typed, same-Country, once per pair.
model CentreServiceCity {
  centreId  String @db.NVarChar(36)
  cityId    String @db.NVarChar(36)
  countryId String @db.NVarChar(36)
  centre    Centre @relation(fields: [centreId, countryId], references: [id, countryId], onDelete: NoAction, onUpdate: NoAction)
  city      City   @relation(fields: [cityId, countryId], references: [id, countryId], onDelete: NoAction, onUpdate: NoAction)

  @@id([centreId, cityId])
  @@index([cityId, centreId])
}

/// One public directory contact of a Centre: a phone, an email or a website.
model CentreContact {
  centreId String @db.NVarChar(36)
  position Int
  channel  String @db.NVarChar(16)
  value    String @db.NVarChar(320)
  centre   Centre @relation(fields: [centreId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([centreId, position])
  @@unique([centreId, channel, value])
}

// Phase 14 — Event: an Editorial aggregate of its own, governed by the shared
// editorial workflow. Its schedule, its Centre and its Galleries are REVISION
// state, so nothing changes when or where a published Event happens except a
// new revision that goes back through independent review.
model Event {
  id String @id @db.NVarChar(36)
  slug String @db.NVarChar(120)
  state String @db.NVarChar(16)
  version Int
  currentRevision Int?
  approvedRevision Int?
  approvedById String? @db.NVarChar(36)
  creatorId String @db.NVarChar(36)
  scheduledRevision Int?
  scheduledAt DateTime? @db.DateTime2
  scheduledTimezone String? @db.NVarChar(64)
  scheduledById String? @db.NVarChar(36)
  scheduleStatus String? @db.NVarChar(32)
  publishedAt DateTime? @db.DateTime2
  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt DateTime @db.DateTime2
  creator User @relation("EventCreator", fields:[creatorId], references:[id], onDelete:NoAction, onUpdate:NoAction)
  reviewer User? @relation("EventReviewer", fields:[approvedById], references:[id], onDelete:NoAction, onUpdate:NoAction)
  scheduler User? @relation("EventScheduler", fields:[scheduledById], references:[id], onDelete:NoAction, onUpdate:NoAction)
  current EventRevision? @relation("EventCurrent", fields:[id,currentRevision], references:[ownerId,number], onDelete:NoAction, onUpdate:NoAction)
  approval EventRevision? @relation("EventApproval", fields:[id,approvedRevision], references:[ownerId,number], onDelete:NoAction, onUpdate:NoAction)
  scheduled EventRevision? @relation("EventScheduled", fields:[id,scheduledRevision], references:[ownerId,number], onDelete:NoAction, onUpdate:NoAction)
  revisions EventRevision[] @relation("EventHistory")
  slugs EventSlugHistory[]
  @@unique([slug])
  @@index([state,updatedAt,id])
  @@index([state,publishedAt(sort: Desc),id])
  @@index([scheduleStatus,scheduledAt,id])
}
model EventRevision {
  ownerId String @db.NVarChar(36)
  number Int
  editorId String @db.NVarChar(36)
  slug String @db.NVarChar(120)
  primaryLanguage String @db.NVarChar(16)
  schemaVersion Int @default(1)
  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  /// The IANA zone the Event is held in — never an offset.
  timezone String @db.NVarChar(64)
  /// The ONE Global Network Centre it is held at, or none. Never cascades.
  centreId String? @db.NVarChar(36)
  centre Centre? @relation(fields:[centreId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  owner Event @relation("EventHistory",fields:[ownerId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  editor User @relation(fields:[editorId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  currentFor Event[] @relation("EventCurrent")
  approvedFor Event[] @relation("EventApproval")
  scheduledFor Event[] @relation("EventScheduled")
  translations EventRevisionTranslation[]
  topics EventTopic[]
  contributors EventContributor[]
  occurrences EventSchedule[]
  galleries EventGallery[]
  @@id([ownerId,number])
  @@index([centreId,ownerId,number])
}
model EventRevisionTranslation {
  ownerId String @db.NVarChar(36)
  revisionNumber Int
  languageCode String @db.NVarChar(16)
  title String @db.NVarChar(200)
  excerpt String @db.NVarChar(600)
  seoTitle String @db.NVarChar(200)
  seoDescription String @db.NVarChar(300)
  document String @db.NVarChar(Max)
  html String @db.NVarChar(Max)
  revision EventRevision @relation(fields:[ownerId,revisionNumber],references:[ownerId,number],onDelete:NoAction,onUpdate:NoAction)
  language Language @relation(fields:[languageCode],references:[code],onDelete:NoAction,onUpdate:NoAction)
  @@id([ownerId,revisionNumber,languageCode])
}
model EventTopic {
  ownerId String @db.NVarChar(36)
  revisionNumber Int
  topicId String @db.NVarChar(36)
  revision EventRevision @relation(fields:[ownerId,revisionNumber],references:[ownerId,number],onDelete:NoAction,onUpdate:NoAction)
  topic Topic @relation(fields:[topicId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@id([ownerId,revisionNumber,topicId])
  @@index([topicId,ownerId])
}
model EventContributor {
  ownerId String @db.NVarChar(36)
  revisionNumber Int
  personId String @db.NVarChar(36)
  role String @db.NVarChar(32)
  position Int
  revision EventRevision @relation(fields:[ownerId,revisionNumber],references:[ownerId,number],onDelete:NoAction,onUpdate:NoAction)
  person Person @relation(fields:[personId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@id([ownerId,revisionNumber,personId,role])
  @@index([personId,ownerId])
}
/// One occurrence of an Event revision: the intended LOCAL wall-clock times in
/// the revision's zone — the fact — and the UTC instants derived from them.
/// Immutable with its revision.
model EventSchedule {
  ownerId String @db.NVarChar(36)
  revisionNumber Int
  position Int
  startsLocal DateTime @db.DateTime2
  startsAt DateTime @db.DateTime2
  endsLocal DateTime? @db.DateTime2
  endsAt DateTime? @db.DateTime2
  revision EventRevision @relation(fields:[ownerId,revisionNumber],references:[ownerId,number],onDelete:NoAction,onUpdate:NoAction)
  @@id([ownerId,revisionNumber,position])
  @@unique([ownerId,revisionNumber,startsAt])
}
/// The typed Event↔Gallery association, OWNED BY EDITORIAL: one Media Gallery's
/// place in one Event revision. Removing it removes no Gallery; archiving a
/// Gallery changes no Event.
model EventGallery {
  ownerId String @db.NVarChar(36)
  revisionNumber Int
  position Int
  galleryId String @db.NVarChar(36)
  revision EventRevision @relation(fields:[ownerId,revisionNumber],references:[ownerId,number],onDelete:NoAction,onUpdate:NoAction)
  gallery Gallery @relation(fields:[galleryId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@id([ownerId,revisionNumber,position])
  @@unique([ownerId,revisionNumber,galleryId])
  @@index([galleryId,ownerId])
}
model EventSlugHistory {
  slug String @db.NVarChar(120)
  ownerId String @db.NVarChar(36)
  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  owner Event @relation(fields:[ownerId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@id([slug])
  @@index([ownerId])
}

// Phase 15 — Collection: an Editorial aggregate of its own, governed by the
// shared editorial workflow. A public, curated, ordered set that REFERENCES
// existing content and owns none of it. Its ordered, typed members are REVISION
// state, so nothing changes what a published Collection gathers, or in what
// order, except a new revision that goes back through independent review. It is
// not a user's private collection, which is Personalisation's.
model Collection {
  id String @id @db.NVarChar(36)
  slug String @db.NVarChar(120)
  state String @db.NVarChar(16)
  version Int
  currentRevision Int?
  approvedRevision Int?
  approvedById String? @db.NVarChar(36)
  creatorId String @db.NVarChar(36)
  scheduledRevision Int?
  scheduledAt DateTime? @db.DateTime2
  scheduledTimezone String? @db.NVarChar(64)
  scheduledById String? @db.NVarChar(36)
  scheduleStatus String? @db.NVarChar(32)
  publishedAt DateTime? @db.DateTime2
  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt DateTime @db.DateTime2
  creator User @relation("CollectionCreator", fields:[creatorId], references:[id], onDelete:NoAction, onUpdate:NoAction)
  reviewer User? @relation("CollectionReviewer", fields:[approvedById], references:[id], onDelete:NoAction, onUpdate:NoAction)
  scheduler User? @relation("CollectionScheduler", fields:[scheduledById], references:[id], onDelete:NoAction, onUpdate:NoAction)
  current CollectionRevision? @relation("CollectionCurrent", fields:[id,currentRevision], references:[ownerId,number], onDelete:NoAction, onUpdate:NoAction)
  approval CollectionRevision? @relation("CollectionApproval", fields:[id,approvedRevision], references:[ownerId,number], onDelete:NoAction, onUpdate:NoAction)
  scheduled CollectionRevision? @relation("CollectionScheduled", fields:[id,scheduledRevision], references:[ownerId,number], onDelete:NoAction, onUpdate:NoAction)
  revisions CollectionRevision[] @relation("CollectionHistory")
  slugs CollectionSlugHistory[]
  @@unique([slug])
  @@index([state,updatedAt,id])
  @@index([state,publishedAt(sort: Desc),id])
  @@index([scheduleStatus,scheduledAt,id])
}
model CollectionRevision {
  ownerId String @db.NVarChar(36)
  number Int
  editorId String @db.NVarChar(36)
  slug String @db.NVarChar(120)
  primaryLanguage String @db.NVarChar(16)
  schemaVersion Int @default(1)
  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  owner Collection @relation("CollectionHistory",fields:[ownerId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  editor User @relation(fields:[editorId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  currentFor Collection[] @relation("CollectionCurrent")
  approvedFor Collection[] @relation("CollectionApproval")
  scheduledFor Collection[] @relation("CollectionScheduled")
  translations CollectionRevisionTranslation[]
  topics CollectionTopic[]
  contributors CollectionContributor[]
  items CollectionItem[]
  @@id([ownerId,number])
}
model CollectionRevisionTranslation {
  ownerId String @db.NVarChar(36)
  revisionNumber Int
  languageCode String @db.NVarChar(16)
  title String @db.NVarChar(200)
  excerpt String @db.NVarChar(600)
  seoTitle String @db.NVarChar(200)
  seoDescription String @db.NVarChar(300)
  document String @db.NVarChar(Max)
  html String @db.NVarChar(Max)
  revision CollectionRevision @relation(fields:[ownerId,revisionNumber],references:[ownerId,number],onDelete:NoAction,onUpdate:NoAction)
  language Language @relation(fields:[languageCode],references:[code],onDelete:NoAction,onUpdate:NoAction)
  @@id([ownerId,revisionNumber,languageCode])
}
model CollectionTopic {
  ownerId String @db.NVarChar(36)
  revisionNumber Int
  topicId String @db.NVarChar(36)
  revision CollectionRevision @relation(fields:[ownerId,revisionNumber],references:[ownerId,number],onDelete:NoAction,onUpdate:NoAction)
  topic Topic @relation(fields:[topicId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@id([ownerId,revisionNumber,topicId])
  @@index([topicId,ownerId])
}
model CollectionContributor {
  ownerId String @db.NVarChar(36)
  revisionNumber Int
  personId String @db.NVarChar(36)
  role String @db.NVarChar(32)
  position Int
  revision CollectionRevision @relation(fields:[ownerId,revisionNumber],references:[ownerId,number],onDelete:NoAction,onUpdate:NoAction)
  person Person @relation(fields:[personId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@id([ownerId,revisionNumber,personId,role])
  @@index([personId,ownerId])
}
/// One place in one Collection revision's SINGLE mixed order, holding EXACTLY
/// ONE typed member — a SQL CHECK counts the seven nullable references, and each
/// is a real, non-cascading foreign key to its owner's table. There is no
/// `targetType + targetId`: a type with no column cannot be a member at all. A
/// record is a member at most once per revision, through FILTERED unique indexes
/// the migration creates (`WHERE [xId] IS NOT NULL`), which Prisma's schema
/// language cannot express. Removing a member removes no content; archiving its
/// target changes no Collection. Immutable with its revision.
model CollectionItem {
  ownerId String @db.NVarChar(36)
  revisionNumber Int
  position Int
  articleId String? @db.NVarChar(36)
  newsArticleId String? @db.NVarChar(36)
  pressReleaseId String? @db.NVarChar(36)
  statementId String? @db.NVarChar(36)
  mediaCoverageId String? @db.NVarChar(36)
  workId String? @db.NVarChar(36)
  videoId String? @db.NVarChar(36)
  revision CollectionRevision @relation(fields:[ownerId,revisionNumber],references:[ownerId,number],onDelete:NoAction,onUpdate:NoAction)
  article Article? @relation(fields:[articleId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  newsArticle NewsArticle? @relation(fields:[newsArticleId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  pressRelease PressRelease? @relation(fields:[pressReleaseId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  statement Statement? @relation(fields:[statementId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  mediaCoverage MediaCoverage? @relation(fields:[mediaCoverageId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  work Work? @relation(fields:[workId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  video Video? @relation(fields:[videoId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@id([ownerId,revisionNumber,position])
}
model CollectionSlugHistory {
  slug String @db.NVarChar(120)
  ownerId String @db.NVarChar(36)
  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  owner Collection @relation(fields:[ownerId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@id([slug])
  @@index([ownerId])
}

// =============================================================================
// Phase 18 — Quran
// =============================================================================
//
// THE CANONICAL CITATION IS THE IDENTITY. An Ayah is `(surahNumber,
// ayahNumber)`; a Surah and a Juz are their numbers. No surrogate key can drift
// from the citation, and a Juz's range is derived from its ayat.
//
// FOUR POSTURES (the migration's header and the runtime grants): sources and
// activation are owner/operator-only; canonical tables are written ONLY by the
// `QuranAcceptCorpus` and `QuranCorrectAyah` procedures; layered works are
// administered under `quran.administer`; Search's vocabulary gains
// `quran-ayah`. No Quran content is seeded.

/// A registered source of Quran text, `fixture` or `approved`. Immutable. The
/// application principal can read it and nothing more.
model QuranSource {
  id        String   @id @db.NVarChar(36)
  code      String   @unique @db.NVarChar(64)
  /// fixture | approved
  authority String   @db.NVarChar(16)
  title     String   @db.NVarChar(200)
  version   String   @db.NVarChar(64)
  /// utf-8: the one transport encoding the verifier implements.
  encoding  String   @db.NVarChar(32)
  script    String?  @db.NVarChar(64)
  /// The external authority's evidence reference; required when approved.
  reference String?  @db.NVarChar(400)
  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  surahs           QuranSourceSurah[]
  activations      QuranActivation[]
  juz              Juz[]
  canonicalSurahs  Surah[]
  ayat             Ayah[]
  revisions        QuranAyahRevision[]
  verificationRuns QuranVerificationRun[]
  translations     QuranTranslation[]
  transliterations QuranTransliteration[]
  tafsirs          QuranTafsir[]
  recitations      QuranRecitation[]
  tajweedRules     QuranTajweedRule[]

  @@map("QuranSource")
}

model QuranSourceSurah {
  sourceId   String  @db.NVarChar(36)
  number     Int
  ayahCount  Int
  revelation String? @db.NVarChar(16)
  nameArabic String? @db.NVarChar(100)

  source QuranSource       @relation(fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ayat   QuranSourceAyah[]

  @@id([sourceId, number])
  @@map("QuranSourceSurah")
}

/// The source's own text and structure for one Ayah, exactly as registered.
model QuranSourceAyah {
  sourceId    String  @db.NVarChar(36)
  surahNumber Int
  ayahNumber  Int
  juzNumber   Int
  hizb        Int?
  page        Int?
  sajdah      String? @db.NVarChar(16)
  text        String  @db.NVarChar(4000)

  surah QuranSourceSurah @relation(fields: [sourceId, surahNumber], references: [sourceId, number], onDelete: NoAction, onUpdate: NoAction)

  @@id([sourceId, surahNumber, ayahNumber])
  @@map("QuranSourceAyah")
}

/// The corpus is public if and only if this single row exists.
model QuranActivation {
  id           Int      @id
  sourceId     String   @db.NVarChar(36)
  activatedAt  DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  authorisedBy String   @db.NVarChar(200)

  source QuranSource @relation(fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("QuranActivation")
}

model Juz {
  number    Int      @id
  sourceId  String   @db.NVarChar(36)
  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  source QuranSource @relation(fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ayat   Ayah[]

  @@map("Juz")
}

model Surah {
  number       Int
  ayahCount    Int
  revelation   String?  @db.NVarChar(16)
  nameArabic   String?  @db.NVarChar(100)
  sourceId     String   @db.NVarChar(36)
  /// The version of the DISPLAY NAMES, the only thing about a Surah that changes.
  namesVersion Int      @default(1)
  createdAt    DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt    DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  source QuranSource @relation(fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ayat   Ayah[]
  names  SurahName[]

  @@id([number])
  @@map("Surah")
}

/// One Ayah. Changed only by `QuranCorrectAyah`, which appends its revision.
model Ayah {
  surahNumber Int
  ayahNumber  Int
  juzNumber   Int
  hizb        Int?
  page        Int?
  sajdah      String?  @db.NVarChar(16)
  text        String   @db.NVarChar(4000)
  sourceId    String   @db.NVarChar(36)
  version     Int
  createdAt   DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt   DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  surah                Surah                      @relation(fields: [surahNumber], references: [number], onDelete: NoAction, onUpdate: NoAction)
  juz                  Juz                        @relation(fields: [juzNumber], references: [number], onDelete: NoAction, onUpdate: NoAction)
  source               QuranSource                @relation(fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revisions            QuranAyahRevision[]
  translationTexts     QuranTranslationText[]
  transliterationTexts QuranTransliterationText[]
  tafsirStarts         QuranTafsirText[]          @relation("QuranTafsirTextStart")
  tafsirEnds           QuranTafsirText[]          @relation("QuranTafsirTextEnd")
  segmentStarts        QuranRecitationSegment[]   @relation("QuranRecitationSegmentStart")
  segmentEnds          QuranRecitationSegment[]   @relation("QuranRecitationSegmentEnd")
  topics               QuranTopic[]
  savedItems           SavedItem[]
  readingHistory       ReadingHistory[]
  quranProgress        QuranReadingProgress[]

  @@id([surahNumber, ayahNumber])
  @@index([juzNumber, surahNumber, ayahNumber])
  @@map("Ayah")
}

/// Immutable, content-free evidence of every verification, passed or failed.
model QuranVerificationRun {
  id          String   @id @db.NVarChar(36)
  /// corpus-acceptance | ayah-correction
  kind        String   @db.NVarChar(24)
  /// passed | failed
  outcome     String   @db.NVarChar(16)
  sourceId    String   @db.NVarChar(36)
  checked     Int
  mismatches  Int
  firstSurah  Int?
  firstAyah   Int?
  firstOffset Int?
  firstReason String?  @db.NVarChar(32)
  actorId     String?  @db.NVarChar(36)
  createdAt   DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  source    QuranSource         @relation(fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revisions QuranAyahRevision[]

  @@index([createdAt(sort: Desc), id])
  @@map("QuranVerificationRun")
}

/// Every canonical version of every Ayah. The actor and grant are HISTORICAL
/// identifiers and carry no foreign key (DOMAIN_MODEL.md §6.2.1).
model QuranAyahRevision {
  surahNumber       Int
  ayahNumber        Int
  version           Int
  text              String   @db.NVarChar(4000)
  sourceId          String   @db.NVarChar(36)
  verificationRunId String   @db.NVarChar(36)
  actorId           String?  @db.NVarChar(36)
  stepUpGrantId     String?  @db.NVarChar(36)
  reason            String?  @db.NVarChar(500)
  createdAt         DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  ayah   Ayah                 @relation(fields: [surahNumber, ayahNumber], references: [surahNumber, ayahNumber], onDelete: NoAction, onUpdate: NoAction)
  source QuranSource          @relation(fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  run    QuranVerificationRun @relation(fields: [verificationRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([surahNumber, ayahNumber, version])
  @@map("QuranAyahRevision")
}

/// A Surah's display name in one interface locale: presentation, not identity.
model SurahName {
  surahNumber Int
  locale      String @db.NVarChar(8)
  name        String @db.NVarChar(100)

  surah Surah @relation(fields: [surahNumber], references: [number], onDelete: NoAction, onUpdate: NoAction)

  @@id([surahNumber, locale])
  @@map("SurahName")
}

model QuranTranslation {
  id           String    @id @db.NVarChar(36)
  /// Immutable once chosen: the runtime holds no UPDATE on it.
  slug         String    @unique @db.NVarChar(120)
  languageCode String    @db.NVarChar(16)
  name         String    @db.NVarChar(200)
  description  String?   @db.NVarChar(2000)
  attribution  String?   @db.NVarChar(400)
  sourceId     String?   @db.NVarChar(36)
  /// draft | published | archived
  state        String    @db.NVarChar(16)
  version      Int
  createdAt    DateTime  @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt    DateTime  @db.DateTime2
  publishedAt  DateTime? @db.DateTime2

  language     Language                      @relation(fields: [languageCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  source       QuranSource?                  @relation(fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contributors QuranTranslationContributor[]
  texts        QuranTranslationText[]

  @@index([state, slug])
  @@map("QuranTranslation")
}

model QuranTranslationContributor {
  translationId String @db.NVarChar(36)
  personId      String @db.NVarChar(36)
  role          String @db.NVarChar(32)
  position      Int

  translation QuranTranslation @relation(fields: [translationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  person      Person           @relation(fields: [personId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([translationId, personId, role])
  @@index([personId])
  @@map("QuranTranslationContributor")
}

model QuranTranslationText {
  translationId String @db.NVarChar(36)
  surahNumber   Int
  ayahNumber    Int
  text          String @db.NVarChar(Max)

  translation QuranTranslation @relation(fields: [translationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ayah        Ayah             @relation(fields: [surahNumber, ayahNumber], references: [surahNumber, ayahNumber], onDelete: NoAction, onUpdate: NoAction)

  @@id([translationId, surahNumber, ayahNumber])
  @@index([surahNumber, ayahNumber], map: "QuranTranslationText_ayah_idx")
  @@map("QuranTranslationText")
}

model QuranTransliteration {
  id           String    @id @db.NVarChar(36)
  slug         String    @unique @db.NVarChar(120)
  languageCode String    @db.NVarChar(16)
  name         String    @db.NVarChar(200)
  description  String?   @db.NVarChar(2000)
  scheme       String?   @db.NVarChar(2000)
  attribution  String?   @db.NVarChar(400)
  sourceId     String?   @db.NVarChar(36)
  state        String    @db.NVarChar(16)
  version      Int
  createdAt    DateTime  @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt    DateTime  @db.DateTime2
  publishedAt  DateTime? @db.DateTime2

  language Language                   @relation(fields: [languageCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  source   QuranSource?               @relation(fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  texts    QuranTransliterationText[]

  @@index([state, slug])
  @@map("QuranTransliteration")
}

model QuranTransliterationText {
  transliterationId String @db.NVarChar(36)
  surahNumber       Int
  ayahNumber        Int
  text              String @db.NVarChar(Max)

  transliteration QuranTransliteration @relation(fields: [transliterationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ayah            Ayah                 @relation(fields: [surahNumber, ayahNumber], references: [surahNumber, ayahNumber], onDelete: NoAction, onUpdate: NoAction)

  @@id([transliterationId, surahNumber, ayahNumber])
  @@index([surahNumber, ayahNumber], map: "QuranTransliterationText_ayah_idx")
  @@map("QuranTransliterationText")
}

model QuranTafsir {
  id           String    @id @db.NVarChar(36)
  slug         String    @unique @db.NVarChar(120)
  languageCode String    @db.NVarChar(16)
  name         String    @db.NVarChar(200)
  description  String?   @db.NVarChar(2000)
  attribution  String?   @db.NVarChar(400)
  sourceId     String?   @db.NVarChar(36)
  state        String    @db.NVarChar(16)
  version      Int
  createdAt    DateTime  @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt    DateTime  @db.DateTime2
  publishedAt  DateTime? @db.DateTime2

  language     Language                 @relation(fields: [languageCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  source       QuranSource?             @relation(fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contributors QuranTafsirContributor[]
  entries      QuranTafsirText[]

  @@index([state, slug])
  @@map("QuranTafsir")
}

model QuranTafsirContributor {
  tafsirId String @db.NVarChar(36)
  personId String @db.NVarChar(36)
  role     String @db.NVarChar(32)
  position Int

  tafsir QuranTafsir @relation(fields: [tafsirId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  person Person      @relation(fields: [personId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([tafsirId, personId, role])
  @@index([personId])
  @@map("QuranTafsirContributor")
}

/// One Tafsir entry over ONE Surah's contiguous range; entries never overlap.
model QuranTafsirText {
  id          String @id @db.NVarChar(36)
  tafsirId    String @db.NVarChar(36)
  surahNumber Int
  startAyah   Int
  endAyah     Int
  text        String @db.NVarChar(Max)

  tafsir QuranTafsir @relation(fields: [tafsirId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  start  Ayah        @relation("QuranTafsirTextStart", fields: [surahNumber, startAyah], references: [surahNumber, ayahNumber], onDelete: NoAction, onUpdate: NoAction)
  end    Ayah        @relation("QuranTafsirTextEnd", fields: [surahNumber, endAyah], references: [surahNumber, ayahNumber], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tafsirId, surahNumber, startAyah], map: "QuranTafsirText_start_key")
  @@index([surahNumber, startAyah, endAyah], map: "QuranTafsirText_ayah_idx")
  @@map("QuranTafsirText")
}

/// A reciter's recitation work. The reciter is a People Person, which grants nothing.
model QuranRecitation {
  id          String    @id @db.NVarChar(36)
  slug        String    @unique @db.NVarChar(120)
  personId    String    @db.NVarChar(36)
  name        String    @db.NVarChar(200)
  style       String?   @db.NVarChar(100)
  attribution String?   @db.NVarChar(400)
  sourceId    String?   @db.NVarChar(36)
  state       String    @db.NVarChar(16)
  version     Int
  createdAt   DateTime  @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt   DateTime  @db.DateTime2
  publishedAt DateTime? @db.DateTime2

  person   Person                   @relation(fields: [personId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source   QuranSource?             @relation(fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  segments QuranRecitationSegment[]

  @@index([state, slug])
  @@index([personId, state])
  @@map("QuranRecitation")
}

/// One audio file over ONE Surah's contiguous range. The bytes are Storage's;
/// one Asset serves at most one segment, and the key never cascades.
model QuranRecitationSegment {
  id           String   @id @db.NVarChar(36)
  recitationId String   @db.NVarChar(36)
  surahNumber  Int
  startAyah    Int
  endAyah      Int
  assetId      String?  @db.NVarChar(36)
  createdAt    DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  recitation QuranRecitation @relation(fields: [recitationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  start      Ayah            @relation("QuranRecitationSegmentStart", fields: [surahNumber, startAyah], references: [surahNumber, ayahNumber], onDelete: NoAction, onUpdate: NoAction)
  end        Ayah            @relation("QuranRecitationSegmentEnd", fields: [surahNumber, endAyah], references: [surahNumber, ayahNumber], onDelete: NoAction, onUpdate: NoAction)
  asset      Asset?          @relation("QuranRecitationSegmentAsset", fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([recitationId, surahNumber, startAyah], map: "QuranRecitationSegment_start_key")
  @@map("QuranRecitationSegment")
}

model QuranTajweedRule {
  id          String    @id @db.NVarChar(36)
  slug        String    @unique @db.NVarChar(120)
  position    Int
  attribution String?   @db.NVarChar(400)
  sourceId    String?   @db.NVarChar(36)
  state       String    @db.NVarChar(16)
  version     Int
  createdAt   DateTime  @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt   DateTime  @db.DateTime2
  publishedAt DateTime? @db.DateTime2

  source QuranSource?           @relation(fields: [sourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  texts  QuranTajweedRuleText[]

  @@index([state, position, slug])
  @@map("QuranTajweedRule")
}

model QuranTajweedRuleText {
  ruleId       String @db.NVarChar(36)
  languageCode String @db.NVarChar(16)
  title        String @db.NVarChar(200)
  body         String @db.NVarChar(Max)

  rule     QuranTajweedRule @relation(fields: [ruleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  language Language         @relation(fields: [languageCode], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@id([ruleId, languageCode])
  @@map("QuranTajweedRuleText")
}

/// Typed topic assignment: real foreign keys to the Ayah and to the Topic.
model QuranTopic {
  surahNumber Int
  ayahNumber  Int
  topicId     String   @db.NVarChar(36)
  createdAt   DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  ayah  Ayah  @relation(fields: [surahNumber, ayahNumber], references: [surahNumber, ayahNumber], onDelete: NoAction, onUpdate: NoAction)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([surahNumber, ayahNumber, topicId])
  @@index([topicId, surahNumber, ayahNumber], map: "QuranTopic_topicId_idx")
  @@map("QuranTopic")
}

// =============================================================================
// Phase 19 — Hadith
// =============================================================================
//
// THE SOURCE IS THE IDENTITY. A Hadith record is `(collection, source system,
// edition, source reference)`, the reference kept exactly as the source wrote
// it; a bare number is never a platform-wide key. The public citation
// `(collection, number)` is a separate reviewed mapping to one candidate.
//
// FOUR POSTURES (the migration's header and the runtime grants): source
// systems, editions and activation are owner/operator-only; canonical tables
// are written ONLY by the Hadith procedures, which re-check the actor's live
// `hadith.editCanonical` grant and `hadith-canonical-edit` step-up; layered
// records are administered under `hadith.administer`; Search's vocabulary gains
// `hadith`. No Hadith content is seeded.
//
// Several keys are COMPOSITE in the database — a record's edition, collection
// and source system; its book within its edition; its chapter within its book;
// a citation's candidate declaring that number. Prisma models the plain
// identifier relation where it cannot express the composite; the database
// enforces the composite.

/// A registered Hadith source system, `fixture` or `approved`. Immutable. The
/// application principal can read it and nothing more.
model HadithSourceSystem {
  id        String   @id @db.NVarChar(36)
  code      String   @unique @db.NVarChar(64)
  /// fixture | approved
  authority String   @db.NVarChar(16)
  title     String   @db.NVarChar(200)
  version   String   @db.NVarChar(64)
  /// utf-8
  encoding  String   @db.NVarChar(32)
  /// The external authority's evidence reference; mandatory when approved.
  reference String?  @db.NVarChar(400)
  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  editions     HadithEdition[]
  records      Hadith[]
  translations HadithTranslation[]
  commentaries HadithCommentary[]
  sciences     HadithScience[]

  @@map("HadithSourceSystem")
}

/// The platform's collection namespace. The slug is chosen once and never
/// changes; display names live in HadithCollectionName under `namesVersion`.
model HadithCollection {
  id           String   @id @db.NVarChar(36)
  slug         String   @unique @db.NVarChar(120)
  position     Int
  namesVersion Int      @default(1)
  createdAt    DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt    DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  editions   HadithEdition[]
  books      HadithBook[]
  records    Hadith[]
  activation HadithActivation?
  citations  HadithCitation[]
  conflicts  HadithConflict[]
  names      HadithCollectionName[]

  @@index([position, slug], map: "HadithCollection_position_idx")
  @@map("HadithCollection")
}

/// One edition of one collection as one source system carries it. Immutable,
/// owner/operator-only.
model HadithEdition {
  id             String   @id @db.NVarChar(36)
  collectionId   String   @db.NVarChar(36)
  sourceSystemId String   @db.NVarChar(36)
  code           String   @db.NVarChar(64)
  title          String   @db.NVarChar(200)
  reference      String?  @db.NVarChar(400)
  createdAt      DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  collection   HadithCollection   @relation(fields: [collectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sourceSystem HadithSourceSystem @relation(fields: [sourceSystemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  books        HadithBook[]
  records      Hadith[]

  @@unique([collectionId, sourceSystemId, code], map: "HadithEdition_code_key")
  @@unique([id, collectionId], map: "HadithEdition_collection_key")
  @@unique([id, collectionId, sourceSystemId], map: "HadithEdition_identity_key")
  @@index([sourceSystemId], map: "HadithEdition_sourceSystemId_idx")
  @@map("HadithEdition")
}

/// A collection is public if and only if its row exists. Owner/operator-only;
/// every row shares one authority.
model HadithActivation {
  collectionId String   @id @db.NVarChar(36)
  /// fixture | approved
  authority    String   @db.NVarChar(16)
  authorisedBy String   @db.NVarChar(200)
  activatedAt  DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  collection HadithCollection @relation(fields: [collectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("HadithActivation")
}

/// A sourced structural unit of ONE edition. `reference` and `title` are the
/// source's own, kept exactly; immutable once created.
model HadithBook {
  id            String   @id @db.NVarChar(36)
  collectionId  String   @db.NVarChar(36)
  editionId     String   @db.NVarChar(36)
  slug          String   @db.NVarChar(120)
  reference     String   @db.NVarChar(64)
  position      Int
  title         String?  @db.NVarChar(400)
  titleLanguage String?  @db.NVarChar(16)
  namesVersion  Int      @default(1)
  createdAt     DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt     DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  collection HadithCollection @relation(fields: [collectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Composite in the database: (editionId, collectionId).
  edition    HadithEdition    @relation(fields: [editionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  language   Language?        @relation("HadithBookTitleLanguage", fields: [titleLanguage], references: [code], onDelete: NoAction, onUpdate: NoAction)
  chapters   HadithChapter[]
  records    Hadith[]
  names      HadithBookName[]

  @@unique([collectionId, slug], map: "HadithBook_slug_key")
  @@unique([editionId, reference], map: "HadithBook_reference_key")
  @@unique([editionId, position], map: "HadithBook_position_key")
  @@unique([id, editionId], map: "HadithBook_edition_key")
  @@index([collectionId, position], map: "HadithBook_collection_position_idx")
  @@map("HadithBook")
}

model HadithChapter {
  id            String   @id @db.NVarChar(36)
  bookId        String   @db.NVarChar(36)
  slug          String   @db.NVarChar(120)
  reference     String   @db.NVarChar(64)
  position      Int
  title         String?  @db.NVarChar(400)
  titleLanguage String?  @db.NVarChar(16)
  namesVersion  Int      @default(1)
  createdAt     DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt     DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  book     HadithBook          @relation(fields: [bookId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  language Language?           @relation("HadithChapterTitleLanguage", fields: [titleLanguage], references: [code], onDelete: NoAction, onUpdate: NoAction)
  records  Hadith[]
  names    HadithChapterName[]

  @@unique([bookId, slug], map: "HadithChapter_slug_key")
  @@unique([bookId, reference], map: "HadithChapter_reference_key")
  @@unique([bookId, position], map: "HadithChapter_position_key")
  @@unique([id, bookId], map: "HadithChapter_book_key")
  @@map("HadithChapter")
}

/// The source-qualified record. Written only by the canonical procedures; its
/// current facts always equal its revision for `version`.
model Hadith {
  id              String   @id @db.NVarChar(36)
  collectionId    String   @db.NVarChar(36)
  sourceSystemId  String   @db.NVarChar(36)
  editionId       String   @db.NVarChar(36)
  /// The source's own reference, exactly as supplied.
  sourceReference String   @db.NVarChar(64)
  /// The collection-local public number this record is a candidate for.
  citationNumber  Int?
  bookId          String   @db.NVarChar(36)
  chapterId       String?  @db.NVarChar(36)
  text            String   @db.NVarChar(Max)
  textLanguage    String   @db.NVarChar(16)
  chain           String?  @db.NVarChar(Max)
  chainLanguage   String?  @db.NVarChar(16)
  version         Int
  createdAt       DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt       DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  collection        HadithCollection         @relation(fields: [collectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sourceSystem      HadithSourceSystem       @relation(fields: [sourceSystemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Composite in the database: (editionId, collectionId, sourceSystemId).
  edition           HadithEdition            @relation(fields: [editionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Composite in the database: (bookId, editionId).
  book              HadithBook               @relation(fields: [bookId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Composite in the database: (chapterId, bookId).
  chapter           HadithChapter?           @relation(fields: [chapterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  language          Language                 @relation("HadithTextLanguage", fields: [textLanguage], references: [code], onDelete: NoAction, onUpdate: NoAction)
  chainLanguageRef  Language?                @relation("HadithChainLanguage", fields: [chainLanguage], references: [code], onDelete: NoAction, onUpdate: NoAction)
  revisions         HadithRevision[]
  citations         HadithCitation[]
  citationRevisions HadithCitationRevision[]
  translations      HadithTranslation[]
  commentaryEntries HadithCommentaryEntry[]
  topics            HadithTopic[]

  @@unique([editionId, sourceReference], map: "Hadith_identity_key")
  @@unique([id, collectionId, citationNumber], map: "Hadith_citation_key")
  @@index([collectionId, citationNumber], map: "Hadith_candidates_idx")
  @@index([bookId, chapterId], map: "Hadith_book_chapter_idx")
  @@map("Hadith")
}

/// Every canonical version of every record, version 1 included. Immutable.
model HadithRevision {
  hadithId        String   @db.NVarChar(36)
  version         Int
  /// created | corrected
  operation       String   @db.NVarChar(16)
  sourceReference String   @db.NVarChar(64)
  citationNumber  Int?
  bookId          String   @db.NVarChar(36)
  chapterId       String?  @db.NVarChar(36)
  text            String   @db.NVarChar(Max)
  textLanguage    String   @db.NVarChar(16)
  chain           String?  @db.NVarChar(Max)
  chainLanguage   String?  @db.NVarChar(16)
  evidence        String   @db.NVarChar(400)
  reason          String?  @db.NVarChar(500)
  /// Historical identifiers: no foreign key.
  actorId         String   @db.NVarChar(36)
  stepUpGrantId   String   @db.NVarChar(36)
  createdAt       DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  hadith         Hadith               @relation(fields: [hadithId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gradings       HadithGrading[]
  verifications  HadithVerification[]
  conflicts      HadithConflict[]     @relation("HadithConflictRevision")
  otherConflicts HadithConflict[]     @relation("HadithConflictOtherRevision")

  @@id([hadithId, version])
  @@map("HadithRevision")
}

/// What a named grader said, where, in the grader's own words — for one version
/// of one record. Immutable; never a platform judgement.
model HadithGrading {
  hadithId      String   @db.NVarChar(36)
  version       Int
  position      Int
  grader        String   @db.NVarChar(200)
  label         String   @db.NVarChar(400)
  labelLanguage String   @db.NVarChar(16)
  reference     String   @db.NVarChar(400)
  createdAt     DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  revision HadithRevision @relation(fields: [hadithId, version], references: [hadithId, version], onDelete: NoAction, onUpdate: NoAction)
  language Language       @relation("HadithGradingLanguage", fields: [labelLanguage], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@id([hadithId, version, position])
  @@unique([hadithId, version, grader], map: "HadithGrading_grader_key")
  @@map("HadithGrading")
}

/// Human verification of ONE version. Immutable.
model HadithVerification {
  id            String   @id @db.NVarChar(36)
  hadithId      String   @db.NVarChar(36)
  version       Int
  evidence      String   @db.NVarChar(400)
  actorId       String   @db.NVarChar(36)
  stepUpGrantId String   @db.NVarChar(36)
  createdAt     DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  revision HadithRevision @relation(fields: [hadithId, version], references: [hadithId, version], onDelete: NoAction, onUpdate: NoAction)

  @@unique([hadithId, version], map: "HadithVerification_version_key")
  @@map("HadithVerification")
}

/// The public citation `(collection, number)` and the one candidate it names.
model HadithCitation {
  collectionId String   @db.NVarChar(36)
  number       Int
  id           String   @unique(map: "HadithCitation_id_key") @db.NVarChar(36)
  hadithId     String   @db.NVarChar(36)
  /// mapped | withdrawn
  state        String   @db.NVarChar(16)
  version      Int
  createdAt    DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt    DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  collection HadithCollection         @relation(fields: [collectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Composite in the database: (hadithId, collectionId, number).
  hadith     Hadith                   @relation(fields: [hadithId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revisions  HadithCitationRevision[]
  savedItems     SavedItem[]
  readingHistory ReadingHistory[]

  @@id([collectionId, number])
  @@index([hadithId], map: "HadithCitation_hadithId_idx")
  @@index([state, collectionId, number], map: "HadithCitation_state_idx")
  @@map("HadithCitation")
}

model HadithCitationRevision {
  collectionId  String   @db.NVarChar(36)
  number        Int
  version       Int
  hadithId      String   @db.NVarChar(36)
  state         String   @db.NVarChar(16)
  evidence      String   @db.NVarChar(400)
  reason        String?  @db.NVarChar(500)
  actorId       String   @db.NVarChar(36)
  stepUpGrantId String   @db.NVarChar(36)
  createdAt     DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  citation HadithCitation @relation(fields: [collectionId, number], references: [collectionId, number], onDelete: NoAction, onUpdate: NoAction)
  hadith   Hadith         @relation(fields: [hadithId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([collectionId, number, version])
  @@map("HadithCitationRevision")
}

/// Conflict evidence between two candidates for one citation. Immutable; the
/// platform never resolves it.
model HadithConflict {
  id             String   @id @db.NVarChar(36)
  collectionId   String   @db.NVarChar(36)
  citationNumber Int
  hadithId       String   @db.NVarChar(36)
  hadithVersion  Int
  otherHadithId  String   @db.NVarChar(36)
  otherVersion   Int
  /// Comma-separated: text, chain, structure, grading.
  facets         String   @db.NVarChar(64)
  detectedAt     DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  collection    HadithCollection @relation(fields: [collectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revision      HadithRevision   @relation("HadithConflictRevision", fields: [hadithId, hadithVersion], references: [hadithId, version], onDelete: NoAction, onUpdate: NoAction)
  otherRevision HadithRevision   @relation("HadithConflictOtherRevision", fields: [otherHadithId, otherVersion], references: [hadithId, version], onDelete: NoAction, onUpdate: NoAction)

  @@index([collectionId, citationNumber], map: "HadithConflict_citation_idx")
  @@index([hadithId], map: "HadithConflict_hadithId_idx")
  @@index([otherHadithId], map: "HadithConflict_otherHadithId_idx")
  @@map("HadithConflict")
}

model HadithCollectionName {
  collectionId String  @db.NVarChar(36)
  /// en | ur | ar
  locale       String  @db.NVarChar(8)
  name         String  @db.NVarChar(200)
  description  String? @db.NVarChar(2000)

  collection HadithCollection @relation(fields: [collectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([collectionId, locale])
  @@map("HadithCollectionName")
}

model HadithBookName {
  bookId String @db.NVarChar(36)
  locale String @db.NVarChar(8)
  name   String @db.NVarChar(200)

  book HadithBook @relation(fields: [bookId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([bookId, locale])
  @@map("HadithBookName")
}

model HadithChapterName {
  chapterId String @db.NVarChar(36)
  locale    String @db.NVarChar(8)
  name      String @db.NVarChar(200)

  chapter HadithChapter @relation(fields: [chapterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([chapterId, locale])
  @@map("HadithChapterName")
}

/// A translation of one record into one language. Several may coexist; none
/// is privileged. Public only while its record is public, it is published and
/// it names a registered source system.
model HadithTranslation {
  id             String    @id @db.NVarChar(36)
  /// Fixed once created: the runtime holds no UPDATE on it.
  hadithId       String    @db.NVarChar(36)
  languageCode   String    @db.NVarChar(16)
  text           String    @db.NVarChar(Max)
  attribution    String?   @db.NVarChar(400)
  sourceSystemId String?   @db.NVarChar(36)
  /// draft | published | archived
  state          String    @db.NVarChar(16)
  version        Int
  createdAt      DateTime  @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt      DateTime  @db.DateTime2
  publishedAt    DateTime? @db.DateTime2

  hadith       Hadith                         @relation(fields: [hadithId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  language     Language                       @relation("HadithTranslationLanguage", fields: [languageCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  sourceSystem HadithSourceSystem?            @relation(fields: [sourceSystemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contributors HadithTranslationContributor[]

  @@index([hadithId, state, languageCode], map: "HadithTranslation_hadithId_idx")
  @@map("HadithTranslation")
}

model HadithTranslationContributor {
  translationId String @db.NVarChar(36)
  personId      String @db.NVarChar(36)
  /// translator | editor
  role          String @db.NVarChar(32)
  position      Int

  translation HadithTranslation @relation(fields: [translationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  person      Person            @relation(fields: [personId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([translationId, personId, role])
  @@index([personId], map: "HadithTranslationContributor_personId_idx")
  @@map("HadithTranslationContributor")
}

/// A commentary work in one language, with at most one entry per record.
model HadithCommentary {
  id             String    @id @db.NVarChar(36)
  /// Immutable once chosen: the runtime holds no UPDATE on it.
  slug           String    @unique @db.NVarChar(120)
  languageCode   String    @db.NVarChar(16)
  name           String    @db.NVarChar(200)
  description    String?   @db.NVarChar(2000)
  attribution    String?   @db.NVarChar(400)
  sourceSystemId String?   @db.NVarChar(36)
  /// draft | published | archived
  state          String    @db.NVarChar(16)
  version        Int
  createdAt      DateTime  @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt      DateTime  @db.DateTime2
  publishedAt    DateTime? @db.DateTime2

  language     Language                      @relation("HadithCommentaryLanguage", fields: [languageCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  sourceSystem HadithSourceSystem?           @relation(fields: [sourceSystemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contributors HadithCommentaryContributor[]
  entries      HadithCommentaryEntry[]

  @@index([state, slug], map: "HadithCommentary_state_slug_idx")
  @@map("HadithCommentary")
}

model HadithCommentaryContributor {
  commentaryId String @db.NVarChar(36)
  personId     String @db.NVarChar(36)
  /// author | translator | editor | compiler
  role         String @db.NVarChar(32)
  position     Int

  commentary HadithCommentary @relation(fields: [commentaryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  person     Person           @relation(fields: [personId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([commentaryId, personId, role])
  @@index([personId], map: "HadithCommentaryContributor_personId_idx")
  @@map("HadithCommentaryContributor")
}

model HadithCommentaryEntry {
  commentaryId String @db.NVarChar(36)
  hadithId     String @db.NVarChar(36)
  text         String @db.NVarChar(Max)

  commentary HadithCommentary @relation(fields: [commentaryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hadith     Hadith           @relation(fields: [hadithId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([commentaryId, hadithId])
  @@index([hadithId], map: "HadithCommentaryEntry_hadithId_idx")
  @@map("HadithCommentaryEntry")
}

/// Study material on the sciences of Hadith. Never a canonical record and
/// never a grading authority.
model HadithScience {
  id             String    @id @db.NVarChar(36)
  /// Immutable once chosen: the runtime holds no UPDATE on it.
  slug           String    @unique @db.NVarChar(120)
  position       Int
  attribution    String?   @db.NVarChar(400)
  sourceSystemId String?   @db.NVarChar(36)
  /// draft | published | archived
  state          String    @db.NVarChar(16)
  version        Int
  createdAt      DateTime  @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt      DateTime  @db.DateTime2
  publishedAt    DateTime? @db.DateTime2

  sourceSystem HadithSourceSystem? @relation(fields: [sourceSystemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  texts        HadithScienceText[]

  @@index([state, position, slug], map: "HadithScience_state_position_idx")
  @@map("HadithScience")
}

model HadithScienceText {
  scienceId    String @db.NVarChar(36)
  languageCode String @db.NVarChar(16)
  title        String @db.NVarChar(200)
  body         String @db.NVarChar(Max)

  science  HadithScience @relation(fields: [scienceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  language Language      @relation("HadithScienceTextLanguage", fields: [languageCode], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@id([scienceId, languageCode])
  @@map("HadithScienceText")
}

/// Typed topic assignment: a real key to the source-qualified record and to
/// the Topic.
model HadithTopic {
  hadithId String @db.NVarChar(36)
  topicId  String @db.NVarChar(36)

  hadith Hadith @relation(fields: [hadithId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([hadithId, topicId])
  @@index([topicId, hadithId], map: "HadithTopic_topicId_idx")
  @@map("HadithTopic")
}

// ===========================================================================
// Phase 20 — Fatwa
// ===========================================================================
//
// Fatwa is its own bounded context (DOMAIN_MODEL.md §12). A QUESTION is
// private personal data; a FATWA is the public ruling, a sequence of immutable
// revisions each carrying a separately written anonymised public question.
// Every workflow table is written only by the `Fatwa*` procedures, which
// re-check live permission (and, for publication, a live `fatwa-publication`
// step-up grant) in SQL; the application principal holds SELECT and EXECUTE.
// Integrity the schema language cannot express — status facts, the frozen
// published slug, composite revision ownership, immutable history — is
// enforced by the migration's CHECKs, composite keys and triggers.

/// The service is open only while this singleton exists. Owner/operator-only;
/// immutable. `approved` carries the organisation's evidence reference.
model FatwaActivation {
  id           Int      @id @db.TinyInt
  /// fixture | approved
  authority    String   @db.NVarChar(16)
  authorisedBy String   @db.NVarChar(200)
  reference    String?  @db.NVarChar(400)
  activatedAt  DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  @@map("FatwaActivation")
}

/// A domain classification that maps onto exactly one canonical Topic. The
/// slug never changes and nothing is deleted.
model FatwaCategory {
  id        String   @id @db.NVarChar(36)
  slug      String   @unique(map: "FatwaCategory_slug_key") @db.NVarChar(120)
  topicId   String   @db.NVarChar(36)
  position  Int
  /// active | archived
  status    String   @db.NVarChar(16)
  version   Int      @default(1)
  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2

  topic     Topic               @relation(fields: [topicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  names     FatwaCategoryName[]
  questions FatwaQuestion[]
  revisions FatwaRevision[]

  @@index([status, position, slug], map: "FatwaCategory_status_position_idx")
  @@index([topicId], map: "FatwaCategory_topicId_idx")
  @@map("FatwaCategory")
}

model FatwaCategoryName {
  categoryId String @db.NVarChar(36)
  /// en | ur | ar
  locale     String @db.NVarChar(8)
  name       String @db.NVarChar(200)

  category FatwaCategory @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([categoryId, locale])
  @@map("FatwaCategoryName")
}

/// A private question. Its text is erased at the asker's account closure.
/// Never selected by a list read; never copied into a public table, search,
/// metadata or an audit payload.
model FatwaQuestion {
  id           String    @id @db.NVarChar(36)
  askerId      String    @db.NVarChar(36)
  body         String?   @db.NVarChar(4000)
  /// submitted | triaged | assigned | answered | declined | closed
  status       String    @db.NVarChar(16)
  categoryId   String?   @db.NVarChar(36)
  assigneeId   String?   @db.NVarChar(36)
  triagedById  String?   @db.NVarChar(36)
  triagedAt    DateTime? @db.DateTime2
  assignedById String?   @db.NVarChar(36)
  assignedAt   DateTime? @db.DateTime2
  declinedById String?   @db.NVarChar(36)
  declinedAt   DateTime? @db.DateTime2
  answeredAt   DateTime? @db.DateTime2
  disposedAt   DateTime? @db.DateTime2
  version      Int
  submittedAt  DateTime  @db.DateTime2
  updatedAt    DateTime  @db.DateTime2

  asker      User           @relation("FatwaQuestionAsker", fields: [askerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignee   User?          @relation("FatwaQuestionAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  triagedBy  User?          @relation("FatwaQuestionTriager", fields: [triagedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedBy User?          @relation("FatwaQuestionAssigner", fields: [assignedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  declinedBy User?          @relation("FatwaQuestionDecliner", fields: [declinedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category   FatwaCategory? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fatwa      Fatwa?

  @@index([askerId, submittedAt(sort: Desc), id], map: "FatwaQuestion_askerId_idx")
  @@index([status, submittedAt, id], map: "FatwaQuestion_status_idx")
  @@index([assigneeId, status, submittedAt], map: "FatwaQuestion_assigneeId_idx")
  @@index([disposedAt, askerId], map: "FatwaQuestion_disposal_idx")
  @@map("FatwaQuestion")
}

/// The ruling for one question. The slug freezes at first publication.
model Fatwa {
  id                  String    @id @db.NVarChar(36)
  questionId          String    @unique(map: "Fatwa_questionId_key") @db.NVarChar(36)
  slug                String    @unique(map: "Fatwa_slug_key") @db.NVarChar(120)
  /// null | drafting | in_review | returned
  reviewState         String?   @db.NVarChar(16)
  pendingRevisionId   String?   @db.NVarChar(36)
  publishedRevisionId String?   @db.NVarChar(36)
  firstPublishedAt    DateTime? @db.DateTime2
  withdrawnAt         DateTime? @db.DateTime2
  version             Int
  createdAt           DateTime  @db.DateTime2
  updatedAt           DateTime  @db.DateTime2

  question          FatwaQuestion    @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pendingRevision   FatwaRevision?   @relation("FatwaPendingRevision", fields: [pendingRevisionId, id], references: [id, fatwaId], onDelete: NoAction, onUpdate: NoAction, map: "Fatwa_pendingRevision_fkey")
  publishedRevision FatwaRevision?   @relation("FatwaPublishedRevision", fields: [publishedRevisionId, id], references: [id, fatwaId], onDelete: NoAction, onUpdate: NoAction, map: "Fatwa_publishedRevision_fkey")
  revisions         FatwaRevision[]  @relation("FatwaRevisions")
  readTallies       FatwaReadTally[]

  @@index([reviewState, updatedAt, id], map: "Fatwa_reviewState_idx")
  @@index([withdrawnAt, firstPublishedAt(sort: Desc), id], map: "Fatwa_public_idx")
  @@map("Fatwa")
}

/// One saved revision, never edited. `publicQuestion` is a separately written
/// anonymised statement — never the private question.
model FatwaRevision {
  id               String   @id @db.NVarChar(36)
  fatwaId          String   @db.NVarChar(36)
  number           Int
  title            String   @db.NVarChar(300)
  publicQuestion   String   @db.NVarChar(4000)
  ruling           String   @db.NVarChar(Max)
  language         String   @db.NVarChar(16)
  categoryId       String   @db.NVarChar(36)
  correctionReason String?  @db.NVarChar(1000)
  authorId         String   @db.NVarChar(36)
  createdAt        DateTime @db.DateTime2

  fatwa        Fatwa                 @relation("FatwaRevisions", fields: [fatwaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  languageRef  Language              @relation(fields: [language], references: [code], onDelete: NoAction, onUpdate: NoAction)
  category     FatwaCategory         @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  author       User                  @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  topics       FatwaRevisionTopic[]
  publications FatwaPublication[]
  decisions    FatwaReviewDecision[]
  pendingFor   Fatwa[]               @relation("FatwaPendingRevision")
  publishedFor Fatwa[]               @relation("FatwaPublishedRevision")

  @@unique([fatwaId, number], map: "FatwaRevision_number_key")
  @@unique([id, fatwaId], map: "FatwaRevision_owner_key")
  @@index([categoryId], map: "FatwaRevision_categoryId_idx")
  @@map("FatwaRevision")
}

/// The typed FatwaTopic junction (DOMAIN_MODEL.md §6.2), per revision.
model FatwaRevisionTopic {
  revisionId String @db.NVarChar(36)
  topicId    String @db.NVarChar(36)

  revision FatwaRevision @relation(fields: [revisionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  topic    Topic         @relation(fields: [topicId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([revisionId, topicId])
  @@index([topicId, revisionId], map: "FatwaRevisionTopic_topicId_idx")
  @@map("FatwaRevisionTopic")
}

/// Each publication of a revision, with its step-up evidence. Never edited.
model FatwaPublication {
  id                String   @id @db.NVarChar(36)
  fatwaId           String   @db.NVarChar(36)
  revisionId        String   @unique(map: "FatwaPublication_revisionId_key") @db.NVarChar(36)
  sequence          Int
  publisherId       String   @db.NVarChar(36)
  publisherPersonId String?  @db.NVarChar(36)
  authorPersonId    String?  @db.NVarChar(36)
  stepUpGrantId     String   @db.NVarChar(36)
  publishedAt       DateTime @db.DateTime2

  revision        FatwaRevision @relation(fields: [revisionId, fatwaId], references: [id, fatwaId], onDelete: NoAction, onUpdate: NoAction, map: "FatwaPublication_revision_fkey")
  publisher       User          @relation(fields: [publisherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  publisherPerson Person?       @relation("FatwaPublicationPublisherPerson", fields: [publisherPersonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  authorPerson    Person?       @relation("FatwaPublicationAuthorPerson", fields: [authorPersonId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([fatwaId, sequence], map: "FatwaPublication_sequence_key")
  @@map("FatwaPublication")
}

/// A return to the drafter or a withdrawal. The note is private. Never edited.
model FatwaReviewDecision {
  id            String   @id @db.NVarChar(36)
  fatwaId       String   @db.NVarChar(36)
  revisionId    String   @db.NVarChar(36)
  /// returned | withdrawn
  decision      String   @db.NVarChar(16)
  note          String   @db.NVarChar(1000)
  actorId       String   @db.NVarChar(36)
  stepUpGrantId String?  @db.NVarChar(36)
  decidedAt     DateTime @db.DateTime2

  revision FatwaRevision @relation(fields: [revisionId, fatwaId], references: [id, fatwaId], onDelete: NoAction, onUpdate: NoAction, map: "FatwaReviewDecision_revision_fkey")
  actor    User          @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fatwaId, decidedAt], map: "FatwaReviewDecision_fatwaId_idx")
  @@map("FatwaReviewDecision")
}

/// Anonymous reads per ruling per UTC day — what `sort=popular` reads. A count
/// and nothing else: no account, address, cookie or user agent.
model FatwaReadTally {
  fatwaId String   @db.NVarChar(36)
  day     DateTime @db.Date
  reads   Int

  fatwa Fatwa @relation(fields: [fatwaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([fatwaId, day])
  @@index([day, fatwaId], map: "FatwaReadTally_day_idx")
  @@map("FatwaReadTally")
}

// ===========================================================================
// Phase 21 — Personalisation & Notifications
// ===========================================================================
//
// One account's OWN continuity (DOMAIN_MODEL.md §14). Every row but the
// newsletter's names exactly one `User`, and every read and write puts that
// account in its own predicate. No content is copied: a saved or read target is
// a real, NON-CASCADING foreign key to its owner's canonical row, one typed
// nullable column per kind with a CHECK that exactly one is set — never
// `targetType + targetId` (§6.2). Archiving content leaves the key valid; a hard
// purge must first call Personalisation's typed release (§14.3), because the
// key refuses the delete until then. Inside the context, a removed parent takes
// its own children with it (a SavedItem's bookmark and note, a collection's
// items); nothing cascades from a User or from content. Integrity the schema
// language cannot express — the exactly-one CHECKs, the filtered unique
// indexes, the newsletter's state facts and the immutable consent history — is
// the migration's.

/// The account's own settings: onboarding answers and the history switch.
/// Absent until the person first answers, skips or sets something.
model PersonalisationProfile {
  userId         String   @id @db.NVarChar(36)
  /// completed | skipped — null while only the history switch has been set
  onboarding     String?  @db.NVarChar(16)
  /// Off until the person turns it on; nothing is recorded while it is off.
  historyEnabled Boolean
  version        Int
  createdAt      DateTime @db.DateTime2
  updatedAt      DateTime @db.DateTime2

  user      User                      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  interests PersonalisationInterest[]
  goals     PersonalisationGoal[]

  @@map("PersonalisationProfile")
}

/// One explicit interest — a public area of the platform, never inferred.
model PersonalisationInterest {
  userId   String @db.NVarChar(36)
  interest String @db.NVarChar(32)

  profile PersonalisationProfile @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, interest])
  @@map("PersonalisationInterest")
}

/// One explicit goal.
model PersonalisationGoal {
  userId String @db.NVarChar(36)
  goal   String @db.NVarChar(32)

  profile PersonalisationProfile @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, goal])
  @@map("PersonalisationGoal")
}

/// A user-owned anchor on EXACTLY ONE typed target. It exists only while a
/// bookmark, a note or a collection membership needs it, and holds no title,
/// status or text of the target. One per account and target, through
/// FILTERED unique indexes the migration creates.
model SavedItem {
  id               String   @id @db.NVarChar(36)
  userId           String   @db.NVarChar(36)
  articleId        String?  @db.NVarChar(36)
  workId           String?  @db.NVarChar(36)
  videoId          String?  @db.NVarChar(36)
  surahNumber      Int?
  ayahNumber       Int?
  hadithCitationId String?  @db.NVarChar(36)
  createdAt        DateTime @db.DateTime2

  user            User                    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  article         Article?                @relation(fields: [articleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  work            Work?                   @relation(fields: [workId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  video           Video?                  @relation(fields: [videoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ayah            Ayah?                   @relation(fields: [surahNumber, ayahNumber], references: [surahNumber, ayahNumber], onDelete: NoAction, onUpdate: NoAction)
  hadithCitation  HadithCitation?         @relation(fields: [hadithCitationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookmark        Bookmark?
  note            Note?
  collectionItems PrivateCollectionItem[]

  @@unique([id, userId], map: "SavedItem_owner_key")
  @@index([userId, createdAt(sort: Desc), id], map: "SavedItem_userId_idx")
  @@map("SavedItem")
}

/// The explicit saved mark on one SavedItem.
model Bookmark {
  savedItemId String   @id @db.NVarChar(36)
  createdAt   DateTime @db.DateTime2

  savedItem SavedItem @relation(fields: [savedItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("Bookmark")
}

/// A private plain-text annotation on one SavedItem. Never logged, indexed,
/// audited or shown to anyone but its owner.
model Note {
  savedItemId String   @id @db.NVarChar(36)
  body        String   @db.NVarChar(2000)
  version     Int
  createdAt   DateTime @db.DateTime2
  updatedAt   DateTime @db.DateTime2

  savedItem SavedItem @relation(fields: [savedItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("Note")
}

/// A person's own list — distinct from an editorial Collection. No slug, no
/// sharing, no public page.
model PrivateCollection {
  id          String   @id @db.NVarChar(36)
  userId      String   @db.NVarChar(36)
  title       String   @db.NVarChar(120)
  description String?  @db.NVarChar(500)
  version     Int
  createdAt   DateTime @db.DateTime2
  updatedAt   DateTime @db.DateTime2

  user  User                    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items PrivateCollectionItem[]

  @@unique([id, userId], map: "PrivateCollection_owner_key")
  @@index([userId, updatedAt(sort: Desc), id], map: "PrivateCollection_userId_idx")
  @@map("PrivateCollection")
}

/// One ordered member. Both keys carry the owner, so a member can only ever
/// be the collection owner's own SavedItem.
model PrivateCollectionItem {
  collectionId String   @db.NVarChar(36)
  savedItemId  String   @db.NVarChar(36)
  userId       String   @db.NVarChar(36)
  position     Int
  addedAt      DateTime @db.DateTime2

  collection PrivateCollection @relation(fields: [collectionId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction, map: "PrivateCollectionItem_collection_fkey")
  savedItem  SavedItem         @relation(fields: [savedItemId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction, map: "PrivateCollectionItem_savedItem_fkey")

  @@id([collectionId, savedItemId])
  @@unique([collectionId, position], map: "PrivateCollectionItem_position_key")
  @@index([savedItemId, userId], map: "PrivateCollectionItem_savedItem_idx")
  @@map("PrivateCollectionItem")
}

/// One row per account and readable target — first and latest read, nothing
/// else. Not an event stream. Recorded only while history is on.
model ReadingHistory {
  id               String   @id @db.NVarChar(36)
  userId           String   @db.NVarChar(36)
  articleId        String?  @db.NVarChar(36)
  workId           String?  @db.NVarChar(36)
  surahNumber      Int?
  ayahNumber       Int?
  hadithCitationId String?  @db.NVarChar(36)
  firstReadAt      DateTime @db.DateTime2
  lastReadAt       DateTime @db.DateTime2

  user           User            @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  article        Article?        @relation(fields: [articleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  work           Work?           @relation(fields: [workId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ayah           Ayah?           @relation(fields: [surahNumber, ayahNumber], references: [surahNumber, ayahNumber], onDelete: NoAction, onUpdate: NoAction)
  hadithCitation HadithCitation? @relation(fields: [hadithCitationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, lastReadAt(sort: Desc), id], map: "ReadingHistory_userId_idx")
  @@map("ReadingHistory")
}

/// One row per account and Video — first and latest watch. No provider
/// identifier, position or telemetry.
model WatchHistory {
  userId         String   @db.NVarChar(36)
  videoId        String   @db.NVarChar(36)
  firstWatchedAt DateTime @db.DateTime2
  lastWatchedAt  DateTime @db.DateTime2

  user  User  @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  video Video @relation(fields: [videoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, videoId])
  @@index([userId, lastWatchedAt(sort: Desc), videoId], map: "WatchHistory_userId_idx")
  @@index([videoId], map: "WatchHistory_videoId_idx")
  @@map("WatchHistory")
}

/// The account's ONE current position in the Quran — a typed Ayah, never its
/// text. Moved only by the reader, under the version they read. Course
/// progress is Learning's (Phase 22), never this.
model QuranReadingProgress {
  userId      String   @id @db.NVarChar(36)
  surahNumber Int
  ayahNumber  Int
  version     Int
  updatedAt   DateTime @db.DateTime2

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ayah Ayah @relation(fields: [surahNumber, ayahNumber], references: [surahNumber, ayahNumber], onDelete: NoAction, onUpdate: NoAction)

  @@index([surahNumber, ayahNumber], map: "QuranReadingProgress_ayah_idx")
  @@map("QuranReadingProgress")
}

/// A departure from the default for one category on one channel. Absent means
/// the default (`NOTIFICATION_DEFAULTS`).
model NotificationPreference {
  userId    String   @db.NVarChar(36)
  /// questions
  category  String   @db.NVarChar(32)
  /// in-app
  channel   String   @db.NVarChar(16)
  enabled   Boolean
  updatedAt DateTime @db.DateTime2

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, category, channel])
  @@map("NotificationPreference")
}

/// A system-generated, one-directional notice to one account. It stores a
/// translatable KIND, never prose, and at most a path on this site.
model Notification {
  id             String    @id @db.NVarChar(36)
  userId         String    @db.NVarChar(36)
  /// question-answered | question-declined
  kind           String    @db.NVarChar(32)
  /// questions
  category       String    @db.NVarChar(32)
  destination    String?   @db.NVarChar(300)
  idempotencyKey String    @db.NVarChar(200)
  createdAt      DateTime  @db.DateTime2
  readAt         DateTime? @db.DateTime2

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, idempotencyKey], map: "Notification_idempotency_key")
  @@index([userId, createdAt(sort: Desc), id], map: "Notification_userId_idx")
  @@map("Notification")
}

/// A newsletter subscription — consent from an address, NOT an account. No
/// relation to `User` exists or may be added (DOMAIN_MODEL.md §14.5). Only the
/// hashes of its link tokens are stored, beside the salts the dispatcher
/// re-derives them from under a key the database never holds; the address
/// itself is kept only while it is `pending` or `confirmed`.
model NewsletterSubscriber {
  id                   String    @id @db.NVarChar(36)
  /// HMAC of the canonical address under `EMAIL_DIGEST_KEY`.
  emailDigest          String    @db.NVarChar(64)
  digestKeyVersion     Int
  email                String?   @db.NVarChar(320)
  /// pending | confirmed | unsubscribed | expired | suppressed
  state                String    @db.NVarChar(16)
  locale               String    @db.NVarChar(8)
  /// Which issuance of a link pair is current; a new submission increments it.
  generation           Int
  confirmTokenHash     String?   @db.NVarChar(64)
  confirmSalt          String?   @db.NVarChar(64)
  confirmExpiresAt     DateTime? @db.DateTime2
  unsubscribeTokenHash String?   @db.NVarChar(64)
  unsubscribeSalt      String?   @db.NVarChar(64)
  tokenKeyVersion      Int?
  submittedAt          DateTime  @db.DateTime2
  confirmedAt          DateTime? @db.DateTime2
  endedAt              DateTime? @db.DateTime2
  version              Int
  updatedAt            DateTime  @db.DateTime2

  consentEvents NewsletterConsentEvent[]

  @@unique([emailDigest], map: "NewsletterSubscriber_emailDigest_key")
  @@index([state, submittedAt(sort: Desc), id], map: "NewsletterSubscriber_state_idx")
  @@index([state, confirmExpiresAt], map: "NewsletterSubscriber_expiry_idx")
  @@map("NewsletterSubscriber")
}

/// Consent evidence: purpose, notice version, source and instant of every
/// change, never edited and never deleted (SECURITY_BASELINE.md §19.1).
model NewsletterConsentEvent {
  id            String   @id @db.NVarChar(36)
  subscriberId  String   @db.NVarChar(36)
  /// submitted | confirmed | unsubscribed | expired | suppressed | reinstated
  event         String   @db.NVarChar(16)
  purpose       String   @db.NVarChar(32)
  noticeVersion String   @db.NVarChar(64)
  /// newsletter-page | email-link | operator | system
  source        String   @db.NVarChar(16)
  locale        String?  @db.NVarChar(8)
  occurredAt    DateTime @db.DateTime2

  subscriber NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([subscriberId, occurredAt], map: "NewsletterConsentEvent_subscriberId_idx")
  @@map("NewsletterConsentEvent")
}

// ===========================================================================
// Phase 22 — Learning: courses & paths (DOMAIN_MODEL.md §13)
// ===========================================================================
//
// THE CATALOGUE AND A PERSON'S OWN STUDY, AND NOTHING THAT SCHEDULES. Course,
// its modules and lessons, LearningPath, Enrolment, lesson Progress and the
// REQUEST side of a trial class. There is no ClassSession, Availability,
// Attendance, Booking, meeting provider or meeting address: those are Phase
// 23's, and no column here can hold one.
//
// TYPED REFERENCES, NEVER COPIES. Topics are Taxonomy's `Topic`, the content
// language Taxonomy's `Language`, teachers People's `Person` — each by a real
// foreign key, none of their words copied. A teacher is public attribution and
// grants nothing. No Video, Work, Asset or Centre relation exists.
//
// NOTHING CASCADES. Every key is NO ACTION; Learning's adapter removes its own
// children explicitly, and a Course is archived, never deleted, so Enrolments
// and Progress on it survive withdrawal.

/// One course in the catalogue.
model Course {
  id String @id @db.NVarChar(36)
  slug String @unique @db.NVarChar(120)
  primaryLocale String @db.NVarChar(8)
  /// draft | published | archived
  state String @db.NVarChar(16)
  /// beginner | intermediate | advanced, or not stated.
  level String? @db.NVarChar(16)
  /// self-paced | live
  format String @db.NVarChar(16)
  languageCode String @db.NVarChar(16)
  /// The latest instant the Course was published; kept when it is withdrawn.
  publishedAt DateTime? @db.DateTime2
  version Int @default(1)
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  language Language @relation(fields: [languageCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  labels CourseLabel[]
  slugs CourseSlugHistory[]
  topics CourseTopic[]
  teachers CourseTeacher[]
  modules CourseModule[]
  paths LearningPathCourse[]
  enrolments Enrolment[]
  trialRequests TrialClassRequest[]
  teachingScopes CourseTeachingAssignment[]
  sessions ClassSession[]
  bookings Booking[]
  @@index([state, publishedAt, slug])
  @@index([state, format, level])
  @@index([languageCode, state])
}

model CourseLabel {
  courseId String @db.NVarChar(36)
  locale String @db.NVarChar(8)
  title String @db.NVarChar(240)
  summary String @db.NVarChar(1000)
  description String @db.NVarChar(Max)
  course Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([courseId, locale])
}

/// Includes the current slug: one namespace reserves every identity permanently.
model CourseSlugHistory {
  slug String @id @db.NVarChar(120)
  courseId String @db.NVarChar(36)
  course Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([courseId])
}

model CourseTopic {
  courseId String @db.NVarChar(36)
  topicId String @db.NVarChar(36)
  course Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([courseId, topicId])
  @@index([topicId, courseId])
}

/// A teacher named on a course: public attribution to People, in display order. Grants nothing.
model CourseTeacher {
  courseId String @db.NVarChar(36)
  personId String @db.NVarChar(36)
  position Int
  course Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  person Person @relation(fields: [personId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([courseId, personId])
  @@unique([courseId, position])
  @@index([personId, courseId])
}

/// One module of a course, in one dense order.
model CourseModule {
  id String @id @db.NVarChar(36)
  courseId String @db.NVarChar(36)
  position Int
  course Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  labels CourseModuleLabel[]
  lessons Lesson[]
  @@unique([courseId, position])
  @@unique([id, courseId], map: "CourseModule_owner_key")
}

model CourseModuleLabel {
  moduleId String @db.NVarChar(36)
  locale String @db.NVarChar(8)
  title String @db.NVarChar(240)
  summary String @db.NVarChar(1000)
  module CourseModule @relation(fields: [moduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([moduleId, locale])
}

/// One lesson of one module. Its key carries the course, so it can only ever
/// sit in a module of that course, and progress can only name it there.
model Lesson {
  id String @id @db.NVarChar(36)
  courseId String @db.NVarChar(36)
  moduleId String @db.NVarChar(36)
  position Int
  module CourseModule @relation(fields: [moduleId, courseId], references: [id, courseId], onDelete: NoAction, onUpdate: NoAction, map: "Lesson_module_fkey")
  labels LessonLabel[]
  progress LessonProgress[]
  @@unique([moduleId, position])
  @@unique([id, courseId], map: "Lesson_owner_key")
  @@index([courseId])
}

model LessonLabel {
  lessonId String @db.NVarChar(36)
  locale String @db.NVarChar(8)
  title String @db.NVarChar(240)
  summary String @db.NVarChar(1000)
  /// Plain text, read only by a learner enrolled on the course.
  body String @db.NVarChar(Max)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([lessonId, locale])
}

/// An ordered curation of courses.
model LearningPath {
  id String @id @db.NVarChar(36)
  slug String @unique @db.NVarChar(120)
  primaryLocale String @db.NVarChar(8)
  /// draft | published | archived
  state String @db.NVarChar(16)
  publishedAt DateTime? @db.DateTime2
  version Int @default(1)
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  labels LearningPathLabel[]
  slugs LearningPathSlugHistory[]
  courses LearningPathCourse[]
  @@index([state, publishedAt, slug])
}

model LearningPathLabel {
  pathId String @db.NVarChar(36)
  locale String @db.NVarChar(8)
  title String @db.NVarChar(240)
  summary String @db.NVarChar(1000)
  description String @db.NVarChar(Max)
  path LearningPath @relation(fields: [pathId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([pathId, locale])
}

model LearningPathSlugHistory {
  slug String @id @db.NVarChar(120)
  pathId String @db.NVarChar(36)
  path LearningPath @relation(fields: [pathId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([pathId])
}

/// One course's place in one path. Unique per path, densely ordered.
model LearningPathCourse {
  pathId String @db.NVarChar(36)
  courseId String @db.NVarChar(36)
  position Int
  path LearningPath @relation(fields: [pathId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([pathId, courseId])
  @@unique([pathId, position])
  @@index([courseId, pathId])
}

/// A person's membership of one course. Not a booking, not a class, not a payment.
model Enrolment {
  userId String @db.NVarChar(36)
  courseId String @db.NVarChar(36)
  enrolledAt DateTime @db.DateTime2
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  progress LessonProgress[]
  @@id([userId, courseId])
  @@index([courseId, userId])
}

/// One lesson a person completed, on a course they are enrolled on. Both keys
/// carry the course, so progress can only name that course's own lesson.
model LessonProgress {
  userId String @db.NVarChar(36)
  courseId String @db.NVarChar(36)
  lessonId String @db.NVarChar(36)
  completedAt DateTime @db.DateTime2
  enrolment Enrolment @relation(fields: [userId, courseId], references: [userId, courseId], onDelete: NoAction, onUpdate: NoAction, map: "LessonProgress_enrolment_fkey")
  lesson Lesson @relation(fields: [lessonId, courseId], references: [id, courseId], onDelete: NoAction, onUpdate: NoAction, map: "LessonProgress_lesson_fkey")
  @@id([userId, lessonId])
  @@index([userId, courseId])
  @@index([lessonId, courseId])
}

/// A person's REQUEST for a trial class on one live course: who and when,
/// nothing else. It reserves no teacher, names no time and books nothing.
model TrialClassRequest {
  id String @id @db.NVarChar(36)
  userId String @db.NVarChar(36)
  courseId String @db.NVarChar(36)
  requestedAt DateTime @db.DateTime2
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Phase 23: the one Booking that confirmed this request, if any. While it
  /// exists the request cannot be withdrawn by deletion (the key refuses it).
  booking Booking?
  @@unique([userId, courseId])
  @@index([courseId, requestedAt])
}

/// Phase 23 — the fail-closed live-learning gate. ONE row at most, written by
/// the owner/operator only (the runtime holds SELECT), immutable once written.
/// No row: live learning is OFF — no window, session or booking can exist.
model LiveLearningActivation {
  id           Int      @id @db.TinyInt
  /// fixture | approved
  authority    String   @db.NVarChar(16)
  authorisedBy String   @db.NVarChar(200)
  reference    String?  @db.NVarChar(400)
  activatedAt  DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
}

/// A TYPED Course teaching scope: this account teaches this Course under this
/// exact Identity RoleAssignment. Current while `endedAt` is null AND Identity
/// still reports the assignment live for `teaching.perform` (re-read every
/// request); afterwards safe history that grants nothing. Never deleted.
model CourseTeachingAssignment {
  id String @id @db.NVarChar(36)
  courseId String @db.NVarChar(36)
  userId String @db.NVarChar(36)
  roleAssignmentId String @db.NVarChar(36)
  grantedAt DateTime @db.DateTime2
  /// Historical attribution, not a relation (SECURITY_BASELINE.md §13.3).
  grantedById String? @db.NVarChar(36)
  endedAt DateTime? @db.DateTime2
  endedById String? @db.NVarChar(36)
  version Int @default(1)
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  course Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roleAssignment RoleAssignment @relation(fields: [roleAssignmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessions ClassSession[]
  @@unique([id, courseId], map: "CourseTeachingAssignment_owner_key")
  @@index([userId, endedAt])
  @@index([roleAssignmentId])
}

/// One bookable window a teacher offers: UTC instants plus the zone and the
/// wall-clock times it was offered in. A confirmed trial Booking claims it
/// whole; a teacher's open windows never overlap.
model Availability {
  id String @id @db.NVarChar(36)
  userId String @db.NVarChar(36)
  startsAt DateTime @db.DateTime2
  endsAt DateTime @db.DateTime2
  timeZone String @db.NVarChar(64)
  startsLocal String @db.NVarChar(16)
  endsLocal String @db.NVarChar(16)
  /// open | withdrawn
  state String @db.NVarChar(16)
  version Int @default(1)
  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookings Booking[]
  @@index([userId, state, startsAt])
  @@index([state, startsAt])
}

/// One class — a regular Course session or a single-participant trial — on a
/// published live Course under a current teaching scope OF THAT COURSE (the
/// composite key carries the Course). The meeting address is held only while
/// scheduled and is NULL by CHECK once completed or cancelled; it is read by
/// exactly one disclosure operation and copied nowhere.
model ClassSession {
  id String @id @db.NVarChar(36)
  courseId String @db.NVarChar(36)
  /// course | trial
  kind String @db.NVarChar(16)
  scopeId String @db.NVarChar(36)
  startsAt DateTime @db.DateTime2
  endsAt DateTime @db.DateTime2
  timeZone String @db.NVarChar(64)
  startsLocal String @db.NVarChar(16)
  endsLocal String @db.NVarChar(16)
  /// scheduled | completed | cancelled
  state String @db.NVarChar(16)
  /// google-meet, or null
  meetingProvider String? @db.NVarChar(32)
  meetingUrl String? @db.NVarChar(200)
  /// The chosen reminder instant, before the start; null for no reminder.
  reminderAt DateTime? @db.DateTime2
  version Int @default(1)
  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  closedAt DateTime? @db.DateTime2
  course Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scope CourseTeachingAssignment @relation(fields: [scopeId, courseId], references: [id, courseId], onDelete: NoAction, onUpdate: NoAction, map: "ClassSession_scope_fkey")
  booking Booking?
  attendance Attendance[]
  intents ClassCommunicationIntent[]
  @@index([state, startsAt])
  @@index([courseId, state, startsAt])
  @@index([scopeId, state, startsAt])
  @@index([state, reminderAt])
}

/// A confirmed trial: exactly one per request, one per session, and one LIVE
/// claim per window (the filtered key). Distinct from Enrolment: it enrols
/// nobody.
model Booking {
  id String @id @db.NVarChar(36)
  requestId String @unique @db.NVarChar(36)
  userId String @db.NVarChar(36)
  courseId String @db.NVarChar(36)
  sessionId String @unique @db.NVarChar(36)
  availabilityId String @db.NVarChar(36)
  /// confirmed | cancelled | completed
  state String @db.NVarChar(16)
  confirmedAt DateTime @db.DateTime2
  confirmedById String? @db.NVarChar(36)
  cancelledAt DateTime? @db.DateTime2
  cancelledById String? @db.NVarChar(36)
  version Int @default(1)
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  request TrialClassRequest @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  availability Availability @relation(fields: [availabilityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([userId, state])
  @@index([courseId, state])
}

/// One participant's mark on one session: present or absent, by the
/// session's current teacher or a narrowly justified operator correction.
/// No note, grade or free text.
model Attendance {
  sessionId String @db.NVarChar(36)
  userId String @db.NVarChar(36)
  /// present | absent
  status String @db.NVarChar(16)
  markedAt DateTime @db.DateTime2
  markedById String? @db.NVarChar(36)
  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([sessionId, userId])
  @@index([userId, sessionId])
}

/// Learning's durable service-mail intent (ARCHITECTURE.md §4.6.1): safe
/// identifiers, a purpose and an instant — never a body, an address or a
/// meeting link. Relayed by the Layer-4 dispatcher through the shared email
/// concern after re-checking what is owed; abandoned when a session moves or
/// closes or a participant leaves.
model ClassCommunicationIntent {
  id String @id @db.NVarChar(36)
  /// learning.booking-confirmed | learning.session-rescheduled | learning.session-cancelled | learning.class-reminder
  purpose String @db.NVarChar(64)
  sessionId String @db.NVarChar(36)
  userId String @db.NVarChar(36)
  dueAt DateTime @db.DateTime2
  /// pending | relayed | abandoned
  state String @db.NVarChar(16)
  idempotencyKey String @unique @db.NVarChar(200)
  claimedUntil DateTime? @db.DateTime2
  relayedAt DateTime? @db.DateTime2
  createdAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([state, dueAt])
  @@index([sessionId, state])
  @@index([userId, state])
}
