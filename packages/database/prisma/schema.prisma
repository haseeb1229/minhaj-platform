// ===========================================================================
// Phase 10 — Media: Video, Series, Playlist (DOMAIN_MODEL.md §11)
// ===========================================================================
//
// THREE AGGREGATES, each with its own table and slug namespace. One Video
// entity — no Program, Lecture or per-provider table: a programme is a Series
// whose `kind` says so, and the curated Watch views are a Video's `format`.
// Speakers are People's `Person`, topics Taxonomy's `Topic`, content languages
// Taxonomy's `Language`, each by a real foreign key; Media copies none of it.
//
// NO FILE RELATION AND NO BYTES. A Video is provider metadata: the provider,
// its identifier and descriptive facts. Nothing here references Storage, and
// no column can hold an embed address, an iframe or HTML.

/// One video, hosted by its provider and described here.
model Video {
  id String @id @db.NVarChar(36)
  slug String @unique @db.NVarChar(120)
  primaryLocale String @db.NVarChar(8)
  state String @db.NVarChar(16)
  isFeatured Boolean @default(false)
  /// youtube | vimeo.
  provider String @db.NVarChar(16)
  /// The provider's own identifier, under a BINARY collation in SQL: YouTube
  /// identifiers are case-sensitive, and two that differ only in case are two
  /// different videos.
  providerVideoId String @db.VarChar(16)
  /// available | unavailable — orthogonal to publication.
  availability String @db.NVarChar(16)
  /// lecture | event | highlight | interview | documentary, or none.
  format String? @db.NVarChar(16)
  languageCode String @db.NVarChar(16)
  durationSeconds Int?
  /// The provider's publication date. A date, never an instant (DOMAIN_MODEL.md §19.5).
  publishedOn DateTime? @db.Date
  /// The provider's own image for this video. Never rendered before activation.
  thumbnailUrl String? @db.NVarChar(2000)
  captions Boolean @default(false)
  /// A transcript the organisation holds. Plain text, never generated.
  transcript String? @db.NVarChar(Max)
  /// At most ONE Series. The episode position exists exactly when the Series
  /// does (a CHECK), and is unique within it through a FILTERED unique index
  /// the migration creates — `WHERE [seriesId] IS NOT NULL` — which Prisma's
  /// schema language cannot express.
  seriesId String? @db.NVarChar(36)
  seriesPosition Int?
  version Int @default(1)
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  language Language @relation(fields: [languageCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  series Series? @relation(fields: [seriesId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  labels VideoLabel[]
  slugs VideoSlugHistory[]
  speakers VideoSpeaker[]
  topics VideoTopic[]
  playlists PlaylistVideo[]
  @@unique([provider, providerVideoId])
  @@index([state, publishedOn, slug])
  @@index([state, isFeatured, publishedOn])
  @@index([state, format, publishedOn])
  @@index([languageCode, state])
}

model VideoLabel {
  videoId String @db.NVarChar(36)
  locale String @db.NVarChar(8)
  title String @db.NVarChar(240)
  description String @db.NVarChar(4000)
  video Video @relation(fields: [videoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([videoId, locale])
}

model VideoSlugHistory {
