// ===========================================================================
// Phase 9 — Research & Publications (Library, DOMAIN_MODEL.md §10.2)
// ===========================================================================
//
// SIX DISTINCT AGGREGATES, each with its own table, slug namespace and typed
// relation sets — never one content table with a type column, and never a
// polymorphic `targetType + targetId` (DOMAIN_MODEL.md §6.2). Contributors are
// People's `Person`, topics Taxonomy's `Topic`, content languages Taxonomy's
// `Language`, each by a real foreign key; Library copies none of their data.
//
// NO FILE RELATION. Phase 9 delivers readable semantic text, not downloads; a
// Storage asset arrives with the owner that genuinely needs one.
/// A research work: abstract, citations and institutional context, with a
/// lifecycle of its own rather than a book's.
model Research {
  id String @id @db.NVarChar(36)
  slug String @unique @db.NVarChar(120)
  primaryLocale String @db.NVarChar(8)
  languageCode String @db.NVarChar(16)
  state String @db.NVarChar(16)
  publicationYear Int?
  /// A date, never an instant (DOMAIN_MODEL.md §19.5).
  publishedOn DateTime? @db.Date
  /// Bounded descriptive text: never a fabricated institution or affiliation.
  institutionalContext String? @db.NVarChar(500)
  abstract String? @db.NVarChar(4000)
  /// Bounded semantic text (a `ReaderDocument`), never markup.
  document String? @db.NVarChar(Max)
  version Int @default(1)
  updatedAt DateTime @default(dbgenerated("SYSUTCDATETIME()")) @db.DateTime2
  language Language @relation(fields: [languageCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  labels ResearchLabel[]
  slugs ResearchSlugHistory[]
  contributors ResearchContributor[]
  topics ResearchTopic[]
  citations ResearchCitation[]
  @@index([state, publicationYear, slug])
  @@index([languageCode, publicationYear, id])
}
model ResearchLabel {
  researchId String @db.NVarChar(36)
  locale String @db.NVarChar(8)
  title String @db.NVarChar(240)
  summary String @db.NVarChar(1000)
  research Research @relation(fields: [researchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([researchId, locale])
}
/// Includes the current slug: one namespace reserves every identity permanently.
model ResearchSlugHistory {
  slug String @id @db.NVarChar(120)
  researchId String @db.NVarChar(36)
  research Research @relation(fields: [researchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([researchId])
}
model ResearchContributor {
  researchId String @db.NVarChar(36)
  personId String @db.NVarChar(36)
  role String @db.NVarChar(24)
  position Int
  research Research @relation(fields: [researchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  person Person @relation(fields: [personId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([researchId, personId, role])
