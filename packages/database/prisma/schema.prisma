  position Int
  track AudioTrack @relation(fields: [trackId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  person Person @relation(fields: [personId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([trackId, personId])
  @@index([personId, trackId])
