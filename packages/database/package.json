{
  "name": "@minhaj/database",
  "version": "0.0.0",
  "private": true,
  "description": "Server-only Prisma and Microsoft SQL Server platform adapter. Layer 0 infrastructure, not a bounded business context.",
  "type": "module",
  "exports": {
    ".": {
      "react-server": "./src/index.ts",
      "node": "./src/index.ts",
      "browser": "./src/client-import-error.ts",
      "default": "./src/index.ts"
    }
  },
  "minhaj": {
    "persistenceAdapters": {
      "root": "src/adapters",
      "owners": {
        "identity-access": "identity-access",
        "taxonomy": "taxonomy",
        "email": {
          "kind": "layer0",
          "concern": "email"
        },
        "rate-limiting": {
          "kind": "layer0",
          "concern": "rate-limiting"
        },
        "auditing": {
          "kind": "layer0",
          "concern": "auditing"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/adapter-mssql": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.4",
    "mssql": "12.7.0",
    "resend": "6.27.0",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "prisma": "7.10.0"
  }
}
