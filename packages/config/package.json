{
  "name": "@minhaj/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint and Prettier configuration, including bounded-context boundary enforcement.",
  "type": "module",
  "exports": {
    "./eslint/base": "./eslint/base.js",
    "./eslint/boundaries": "./eslint/boundaries.js",
    "./eslint/rtl": "./eslint/rtl.js",
    "./eslint/contexts": "./eslint/contexts.js",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./tsconfig/next.json": "./tsconfig/next.json",
    "./prettier": "./prettier/index.js"
  },
  "files": [
    "eslint",
    "tsconfig",
    "prettier"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
