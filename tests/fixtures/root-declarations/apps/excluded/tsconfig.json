{
  "compilerOptions": {
    "baseUrl": ".",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ESNext",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "*.d.ts"],
  "exclude": ["ambient.d.ts"]
}
