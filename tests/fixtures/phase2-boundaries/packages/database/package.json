{
  "name": "@minhaj/database",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "minhaj": {
    "persistenceAdapters": {
      "root": "src/adapters",
      "owners": {
        "identity-access": "identity-access",
        "email": {
          "kind": "layer0",
          "concern": "email"
        }
      }
    },
    "architecturalRole": "platform"
  }
}
