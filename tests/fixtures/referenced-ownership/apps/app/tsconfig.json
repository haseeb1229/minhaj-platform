{
  "compilerOptions": {
    "baseUrl": ".",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ESNext",
    "noEmit": true,
    "skipLibCheck": true,
    "paths": { "#target": ["./src/contexts/quran/internal.ts"] }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/child/**/*"],
  "references": [{ "path": "./src/child" }]
}
