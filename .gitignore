# Testing and coverage
# ---------------------------------------------------------------------------
coverage/
.nyc_output/

# Round 6 (B2), as above: authored fixture source in a directory named
# `coverage`, not coverage output.
!tests/fixtures/**/src/coverage/
!tests/fixtures/**/src/coverage/**

# Playwright — reports and run artifacts only.
# Test specs, fixtures and configuration remain tracked.
/test-results/
/playwright-report/
/playwright/.cache/
/blob-report/

# The storage proof's machine-readable report. Generated by the CI gate that
# asserts those proofs actually ran; never an input to anything.
/storage-report.json

# ---------------------------------------------------------------------------
# Prisma — generated client and local database artifacts only.
# schema.prisma, migrations/ and seed scripts remain tracked.
# ---------------------------------------------------------------------------
prisma/generated/
prisma/*.db
prisma/*.db-journal
prisma/.env

# ---------------------------------------------------------------------------
# Database backup artifacts (Phase 1 Chunk 3)
#
# The Phase 1 recovery rehearsal writes its `.bak` SERVER-SIDE, inside the SQL
# Server container's own volume, so a backup binary has no path into the
# working tree at all. These patterns are the second line of that defence, for
# a developer who restores or copies one onto the host by hand: a database
# backup carries every audit row, and belongs in no commit.
# ---------------------------------------------------------------------------
*.bak
*.trn
*.bacpac

# ---------------------------------------------------------------------------
# Docker / local runtime state
# Compose files and Dockerfiles remain tracked.
# ---------------------------------------------------------------------------
docker-compose.override.yml
.docker/data/
*.pid

# ---------------------------------------------------------------------------
# Editor and IDE local metadata
# ---------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo

# ---------------------------------------------------------------------------
# OS artifacts
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
