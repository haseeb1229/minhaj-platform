{
  "name": "minhaj-platform",
  "version": "0.0.0",
  "private": true,
  "description": "One Minhaj — unified multilingual digital platform for Minhaj-ul-Quran International.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "mysql2": "3.23.1"
  },
  "scripts": {
    "db:generate": "node --conditions=react-server packages/database/scripts/prisma-cli.ts generate",
    "db:validate": "node --conditions=react-server packages/database/scripts/prisma-cli.ts validate",
    "db:test:connection": "node --conditions=react-server packages/database/scripts/test-connection.ts",
    "db:migrate:test": "node --conditions=react-server packages/database/scripts/migrate-test.ts",
    "db:test:permissions": "node --conditions=react-server packages/database/scripts/test-permissions.ts",
    "db:seed": "node --conditions=react-server packages/database/scripts/seed.ts",
    "db:provision": "node --conditions=react-server packages/database/scripts/provision-principal.ts",
    "db:provision:operator": "node --conditions=react-server packages/database/scripts/provision-operator.ts",
    "db:test:operator": "node --conditions=react-server packages/database/scripts/test-operator-permissions.ts",
    "identity:bootstrap": "node --conditions=react-server packages/database/scripts/bootstrap-administrator.ts",
    "identity:recover": "node --conditions=react-server packages/database/scripts/recover-privileged-mfa.ts",
    "db:migrate:deploy": "node --conditions=react-server packages/database/scripts/migrate-deploy.ts",
    "db:backup": "node --conditions=react-server packages/database/scripts/backup.ts",
    "db:restore:test": "node --conditions=react-server packages/database/scripts/restore-test.ts",
    "db:recovery:test": "node --conditions=react-server packages/database/scripts/recovery-test.ts",
    "db:recovery:populated": "node --conditions=react-server packages/database/scripts/recovery-populated-test.ts",
    "donations:sandbox:proof": "node --conditions=react-server packages/database/scripts/donations-sandbox-proof.ts",
    "staging:db:inspect": "node --conditions=react-server packages/database/scripts/staging-inspect.ts",
    "staging:db:create": "node --conditions=react-server packages/database/scripts/staging-create.ts",
    "staging:db:migrate": "node --conditions=react-server packages/database/scripts/staging-migrate.ts",
    "staging:db:provision": "node --conditions=react-server packages/database/scripts/staging-provision.ts",
    "staging:db:seed": "node --conditions=react-server packages/database/scripts/staging-seed.ts",
    "staging:db:backup": "node --conditions=react-server packages/database/scripts/staging-backup.ts",
    "staging:db:restore-proof": "node --conditions=react-server packages/database/scripts/staging-restore-proof.ts",
    "staging:db:reset": "node --conditions=react-server packages/database/scripts/staging-reset.ts",
    "staging:migration:proof": "node --conditions=react-server packages/database/scripts/staging-migration-proof.ts",
    "staging:migration:run": "node --conditions=react-server packages/database/scripts/staging-migration-run.ts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tooling.json",
    "lint": "eslint .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:rtl": "node scripts/check-rtl.mjs",
    "check:server-only": "node scripts/check-server-only.mjs",
    "check:versions": "node scripts/verify-versions.mjs",
    "check:docker-context": "node scripts/check-docker-context.mjs",
    "check:dependency-audit": "node scripts/verify-dependency-audit.mjs",
    "test": "vitest run",
    "test:storage": "vitest run tests/storage",
    "test:search": "vitest run tests/search",
    "test:messaging": "vitest run tests/messaging",
    "test:membership": "vitest run tests/membership",
    "test:donations": "vitest run tests/donations",
    "test:realtime": "vitest run tests/realtime",
    "test:migration": "vitest run tests/migration",
    "build": "npm run build --workspaces --if-present",
    "migration:run-fixture": "node --conditions=react-server scripts/migration/run-fixture.ts",
    "migration:promote": "node --conditions=react-server scripts/migration/promote.ts",
    "migration:register-source": "node --conditions=react-server scripts/migration/register-source.ts",
    "migration:run": "node --conditions=react-server scripts/migration/run-source.ts",
    "realtime:start": "node --conditions=react-server apps/web/src/composition/realtime-main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check:versions && npm run check:docker-context && npm run format:check && npm run typecheck && npm run lint && npm run check:architecture && npm run check:rtl && npm run test && npm run check:server-only && npm run build",
    "test:browser": "node --conditions=react-server node_modules/@playwright/test/cli.js test",
    "test:browser:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.55.1",
    "@types/node": "^24.10.1",
    "cheerio": "1.2.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "~4.1.12"
  }
}
